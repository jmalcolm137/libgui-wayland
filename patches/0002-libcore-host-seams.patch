+#include <AK/String.h>
 #include <LibCore/DirIterator.h>
 #include <LibCore/ResourceImplementation.h>
 #include <LibCore/ResourceImplementationFile.h>
 #include <LibCore/System.h>
+#include <stdlib.h>
 
 namespace Core {
 
@@ -20,8 +22,16 @@ void ResourceImplementation::install(OwnPtr<ResourceImplementation> the)
 
 ResourceImplementation& ResourceImplementation::the()
 {
-    if (!s_the)
-        install(make<ResourceImplementationFile>("/res"_string));
+    if (!s_the) {
+        // On a host build, /res does not exist. Allow the resource root to be
+        // relocated with SERENITY_RES_ROOT so that namespace-scope users such as
+        // LibGUI/Calendar.cpp can load fonts from their static initializers,
+        // before any application code has run.
+        ByteString root = "/res";
+        if (auto const* env = getenv("SERENITY_RES_ROOT"); env && *env)
+            root = ByteString(env);
+        install(make<ResourceImplementationFile>(MUST(String::from_byte_string(root))));
+    }
     return *s_the;
 }
 
