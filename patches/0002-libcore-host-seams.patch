diff --git a/Userland/Libraries/LibCore/PortalServer.h b/Userland/Libraries/LibCore/PortalServer.h
new file mode 100644
index 00000000..de3c3dda
--- /dev/null
+++ b/Userland/Libraries/LibCore/PortalServer.h
@@ -0,0 +1,52 @@
+/*
+ * Copyright (c) 2026, libgui-wayland contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteString.h>
+#include <AK/Function.h>
+#include <AK/NonnullOwnPtr.h>
+#include <AK/Optional.h>
+
+namespace Core {
+
+class LocalSocket;
+
+// Lets an in-process component (LibWM) answer connections that would normally
+// go to a SerenityOS system service over a Unix socket.
+//
+// This is the single seam through which libgui-wayland redirects the
+// WindowServer / Clipboard / Config / ... portals, so that LibGUI and the
+// applications it drives remain byte-for-byte unmodified. When no connector is
+// installed, LocalSocket::connect() behaves exactly as on SerenityOS.
+class PortalServer {
+public:
+    // Returns a connected in-process socket for `path`, or an empty Optional to
+    // fall back to the real filesystem socket.
+    using Connector = Function<Optional<NonnullOwnPtr<LocalSocket>>(ByteString const& path)>;
+
+    static void set_connector(Connector connector)
+    {
+        connector_slot() = move(connector);
+    }
+
+    static Optional<NonnullOwnPtr<LocalSocket>> try_connect(ByteString const& path)
+    {
+        auto& connector = connector_slot();
+        if (!connector)
+            return {};
+        return connector(path);
+    }
+
+private:
+    static Connector& connector_slot()
+    {
+        static Connector s_connector;
+        return s_connector;
+    }
+};
+
+}
