diff --git a/Userland/Libraries/LibCore/PortalServer.h b/Userland/Libraries/LibCore/PortalServer.h
new file mode 100644
index 00000000..237c7158
--- /dev/null
+++ b/Userland/Libraries/LibCore/PortalServer.h
@@ -0,0 +1,60 @@
+/*
+ * Copyright (c) 2026, libgui-wayland contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteString.h>
+#include <AK/Function.h>
+#include <AK/NonnullOwnPtr.h>
+#include <AK/Optional.h>
+#include <AK/Vector.h>
+
+namespace Core {
+
+class LocalSocket;
+
+// Lets in-process components answer connections that would normally go to a
+// SerenityOS system service over a Unix socket.
+//
+// This is the seam through which the Wayland shims redirect the WindowServer /
+// Clipboard / Config / Audio / ... portals, so that SerenityOS libraries and the
+// applications they drive remain byte-for-byte unmodified. Multiple providers
+// register independently (LibWM for the windowing portals, LibSerenityAudio for
+// the audio ones); each is tried in turn and the first that recognises a path
+// wins. When no connector is installed, LocalSocket::connect() behaves exactly
+// as on SerenityOS.
+class PortalServer {
+public:
+    // Returns a connected in-process socket for `path`, or an empty Optional to
+    // decline it (so the next connector, or the real filesystem socket, is tried).
+    using Connector = Function<Optional<NonnullOwnPtr<LocalSocket>>(ByteString const& path)>;
+
+    static void add_connector(Connector connector)
+    {
+        connector_list().append(move(connector));
+    }
+
+    static Optional<NonnullOwnPtr<LocalSocket>> try_connect(ByteString const& path)
+    {
+        for (auto& connector : connector_list()) {
+            if (auto socket = connector(path); socket.has_value())
+                return socket;
+        }
+        return {};
+    }
+
+private:
+    // Heap-allocated and never destroyed: connectors are installed from static
+    // initializers, and tearing them down during __cxa_finalize would race the
+    // server threads they feed.
+    static Vector<Connector>& connector_list()
+    {
+        static auto* s_connectors = new Vector<Connector>;
+        return *s_connectors;
+    }
+};
+
+}
