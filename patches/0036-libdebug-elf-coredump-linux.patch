@@ -0,0 +1,52 @@
+/*
+ * Copyright (c) 2026, libgui-wayland contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+// The register set ptrace exchanges. SerenityOS defines its own
+// <sys/arch/regs.h>; on the host we use the native struct user_regs_struct and
+// the native ptrace command set, so LibDebug is Linux-native rather than built
+// against a stand-in for the SerenityOS kernel ABI.
+
+#if defined(AK_OS_SERENITY)
+#    include <sys/arch/regs.h>
+#else
+#    include <AK/Types.h>
+#    include <LibELF/Registers.h>
+#    include <signal.h>
+#    include <stddef.h>
+#    include <sys/ptrace.h>
+#    include <sys/user.h>
+#    include <sys/wait.h>
+
+// SerenityOS ptrace requests map onto the Linux ones. The debug-register
+// requests (PT_PEEKDEBUG/PT_POKEDEBUG) are not aliased here: Linux addresses
+// debug registers through PTRACE_{PEEK,POKE}USER with a struct user offset, so
+// DebugSession branches on those.
+#    define PT_TRACE_ME PTRACE_TRACEME
+#    define PT_ATTACH PTRACE_ATTACH
+#    define PT_DETACH PTRACE_DETACH
+#    define PT_CONTINUE PTRACE_CONT
+#    define PT_SYSCALL PTRACE_SYSCALL
+#    define PT_GETREGS PTRACE_GETREGS
+#    define PT_SETREGS PTRACE_SETREGS
+#    define PT_PEEK PTRACE_PEEKDATA
+#    define PT_POKE PTRACE_POKEDATA
+#    define PT_SINGLESTEP PTRACE_SINGLESTEP
+
+// SerenityOS debug-register indices (Linux: the same x86 DR numbers).
+#    define DEBUG_STATUS_REGISTER 6
+#    define DEBUG_CONTROL_REGISTER 7
+
+// SerenityOS waitpid flags (glibc may already define these).
+#    ifndef WSTOPPED
+#        define WSTOPPED WUNTRACED
+#    endif
+#    ifndef WEXITED
+#        define WEXITED 0
+#    endif
+
+#endif
