@@ -0,0 +1,27 @@
+/*
+ * Copyright (c) 2026, libgui-wayland contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+// The register set stored in an ELF core note (and exchanged over ptrace).
+// SerenityOS gets it from <sys/arch/regs.h>; on the host it is the native
+// struct user_regs_struct. This header is the single definition shared by LibELF
+// (core notes) and LibDebug (ptrace).
+
+#if defined(AK_OS_SERENITY)
+#    include <sys/arch/regs.h>
+#else
+#    include <AK/Types.h>
+#    include <sys/user.h>
+
+struct [[gnu::packed]] PtraceRegisters : public user_regs_struct {
+    FlatPtr ip() const { return rip; }
+    void set_ip(FlatPtr ip) { rip = ip; }
+    FlatPtr bp() const { return rbp; }
+    void set_bp(FlatPtr bp) { rbp = bp; }
+};
+
+#endif
