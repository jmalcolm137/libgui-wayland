+        if (m_on_initialization_progress)
+            m_on_initialization_progress(0);
+    });
+
+    size_t total_lines = 0;
+    for (auto line : maps_text.split_view('\n')) {
+        if (!line.is_empty())
+            ++total_lines;
+    }
+
+    size_t line_index = 0;
+    for (auto line : maps_text.split_view('\n')) {
+        if (line.is_empty())
+            continue;
+        ++line_index;
+        if (m_on_initialization_progress)
+            m_on_initialization_progress(line_index / static_cast<float>(total_lines));
+
+        // Fields: range perms offset dev inode path
+        Vector<StringView> fields;
+        size_t cursor = 0;
+        while (cursor < line.length()) {
+            while (cursor < line.length() && (line[cursor] == ' ' || line[cursor] == '\t'))
+                ++cursor;
+            size_t start = cursor;
+            while (cursor < line.length() && line[cursor] != ' ' && line[cursor] != '\t')
+                ++cursor;
+            if (cursor > start)
+                fields.append(line.substring_view(start, cursor - start));
+        }
+        if (fields.size() < 6)
+            continue;
+
+        auto object_path = fields[5].to_byte_string();
+        if (!object_path.starts_with('/'))
+            continue;
+
+        ByteString lib_name = object_path;
+        if (FileSystem::looks_like_shared_library(lib_name))
+            lib_name = LexicalPath::basename(object_path);
+
+        if (m_loaded_libraries.contains(lib_name))
+            continue;
+
+        auto dash = fields[0].find('-').value();
+        auto base_address = AK::StringUtils::convert_to_uint_from_hex<FlatPtr>(fields[0].substring_view(0, dash)).value_or(0);
