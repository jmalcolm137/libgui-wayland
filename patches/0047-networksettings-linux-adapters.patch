+#if !defined(AK_OS_SERENITY)
+// Host build (libgui-wayland): SerenityOS lists interfaces via
+// /sys/kernel/net/adapters; enumerate the host's interfaces natively instead.
+static Vector<ByteString> host_network_adapters()
+{
+    Vector<ByteString> names;
+    struct ifaddrs* ifaddr = nullptr;
+    if (getifaddrs(&ifaddr) != 0)
+        return names;
+    for (auto* ifa = ifaddr; ifa; ifa = ifa->ifa_next) {
+        if (!ifa->ifa_name)
+            continue;
+        ByteString name { ifa->ifa_name };
+        if (name == "lo"sv)
+            continue;
+        if (!names.contains_slow(name))
+            names.append(move(name));
+    }
+    freeifaddrs(ifaddr);
+    return names;
+}
+#endif
