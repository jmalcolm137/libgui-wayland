+    // headless tests never collide on /tmp/portal/wm.
+    if (general_path == "/tmp/portal/wm"sv) {
+        if (auto const* wm_portal = getenv("LIBWM_WM_PORTAL_PATH"); wm_portal && *wm_portal)
+            return ByteString(wm_portal);
+        if (auto const* runtime_dir = getenv("XDG_RUNTIME_DIR"); runtime_dir && *runtime_dir) {
+            auto const* display = getenv("WAYLAND_DISPLAY");
+            if (display && *display && !StringView { display, strlen(display) }.contains('/'))
+                return ByteString::formatted("{}/libgui-wm-{}", runtime_dir, display);
+            return ByteString::formatted("{}/libgui-wm", runtime_dir);
+        }
+    }
