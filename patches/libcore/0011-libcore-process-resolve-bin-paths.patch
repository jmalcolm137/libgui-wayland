+ByteString Process::resolve_executable_path(StringView path)
+{
+    // SerenityOS installs applications under /bin, but on the host they live
+    // next to the running executable. Map "/bin/X" to that binary when "/bin/X"
+    // does not exist, so unmodified apps can spawn Serenity applications.
+    if (!path.starts_with("/bin/"sv))
+        return path.to_byte_string();
+
+    auto as_byte_string = path.to_byte_string();
+    auto basename = LexicalPath(path).basename();
+
+    // A session may shadow /bin with its own helpers, such as a desktop's
+    // wrappers for /bin/shutdown, /bin/reboot and /bin/logout, in
+    // LIBWM_SESSION_BIN_DIR.
+    if (auto const* session_bin = getenv("LIBWM_SESSION_BIN_DIR"); session_bin && *session_bin) {
+        auto candidate = ByteString::formatted("{}/{}", session_bin, basename);
+        if (::access(candidate.characters(), X_OK) == 0)
+            return candidate;
+    }
+
+    // The session's applications live in LIBWM_APP_BIN_DIR, which need not be
+    // the caller's directory (a desktop may build helpers such as its taskbar
+    // applets elsewhere). Consult it before the caller-directory fallback, so an
+    // applet spawning /bin/SystemMonitor reaches the session's SystemMonitor
+    // rather than a non-existent <applet-dir>/SystemMonitor.
+    if (auto const* app_bin = getenv("LIBWM_APP_BIN_DIR"); app_bin && *app_bin) {
+        auto candidate = ByteString::formatted("{}/{}", app_bin, basename);
+        if (::access(candidate.characters(), X_OK) == 0)
+            return candidate;
+    }
+
+    if (::access(as_byte_string.characters(), X_OK) == 0)
+        return as_byte_string;
+
+    char buffer[4096];
+    auto length = ::readlink("/proc/self/exe", buffer, sizeof(buffer) - 1);
+    if (length <= 0)
+        return as_byte_string;
+    buffer[length] = '\0';
+
+    LexicalPath const self_path { StringView { buffer, static_cast<size_t>(length) } };
+    auto directory = self_path.dirname();
+    return ByteString::formatted("{}/{}", directory, basename);
+}
