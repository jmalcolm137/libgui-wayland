+struct StackSymbol {
+    FlatPtr address { 0 };
+    ByteString name {};
+    ByteString object {};
+    u32 offset { 0 };
+    bool operator==(StackSymbol const&) const = default;
+};
+
+#if defined(__linux__)
+
+static StackSymbol resolve_address(Dwfl* dwfl, FlatPtr address)
+{
+    StackSymbol symbol;
+    symbol.address = address;
+
+    auto* module = dwfl_addrmodule(dwfl, address);
+    if (!module)
+        return symbol;
+
+    if (auto const* name = dwfl_module_addrname(module, address))
+        symbol.name = name;
+
+    Dwarf_Addr start = 0;
+    Dwarf_Addr end = 0;
+    char const* mainfile = nullptr;
+    dwfl_module_info(module, nullptr, &start, &end, nullptr, nullptr, &mainfile, nullptr);
+    if (mainfile)
+        symbol.object = LexicalPath::basename(mainfile);
+    if (address >= start)
+        symbol.offset = static_cast<u32>(address - start);
+    return symbol;
+}
+
+static Vector<StackSymbol> symbolize_thread_linux(pid_t pid, pid_t tid)
+{
+    Vector<StackSymbol> symbols;
+
+    Dwfl_Callbacks callbacks {};
+    callbacks.find_elf = dwfl_linux_proc_find_elf;
+    callbacks.find_debuginfo = dwfl_standard_find_debuginfo;
+
+    auto* dwfl = dwfl_begin(&callbacks);
+    if (!dwfl)
+        return symbols;
+    ScopeGuard end_dwfl = [dwfl] { dwfl_end(dwfl); };
+
+    if (dwfl_linux_proc_report(dwfl, pid) != 0)
+        return symbols;
+    dwfl_report_end(dwfl, nullptr, nullptr);
+
+    auto address_space = unw_create_addr_space(&_UPT_accessors, 0);
+    if (!address_space)
+        return symbols;
+    ScopeGuard destroy_as = [address_space] { unw_destroy_addr_space(address_space); };
+
+    auto* upt = _UPT_create(tid);
+    if (!upt)
+        return symbols;
+    ScopeGuard destroy_upt = [upt] { _UPT_destroy(upt); };
+
+    unw_cursor_t cursor;
+    if (unw_init_remote(&cursor, address_space, upt) < 0)
+        return symbols;
+
+    do {
+        unw_word_t ip = 0;
+        if (unw_get_reg(&cursor, UNW_REG_IP, &ip) < 0 || ip == 0)
+            break;
+        symbols.append(resolve_address(dwfl, static_cast<FlatPtr>(ip)));
+    } while (unw_step(&cursor) > 0);
+
+    return symbols;
+}
+
