 ErrorOr<AllProcessesStatistics> ProcessStatisticsReader::get_all(bool include_usernames)
 {
+#if defined(AK_OS_SERENITY)
     auto proc_all_file = TRY(Core::File::open("/sys/kernel/processes"sv, Core::File::OpenMode::Read));
     return get_all(*proc_all_file, include_usernames);
+#else
+    // Linux-native reader: fill the same Core::ProcessStatistics model from
+    // /proc, so SystemMonitor (and anything else) has the same end-user
+    // behaviour without a Serenity /sys/kernel shim.
+    auto result = TRY(get_all_from_linux_proc());
+    if (include_usernames) {
+        for (auto& process : result.processes)
+            process.username = username_from_uid(process.uid);
+    }
+    return result;
+#endif
 }
 
