diff --git a/Userland/Applications/SystemMonitor/SystemMonitorLinux.cpp b/Userland/Applications/SystemMonitor/SystemMonitorLinux.cpp
new file mode 100644
index 00000000..e544b759
--- /dev/null
+++ b/Userland/Applications/SystemMonitor/SystemMonitorLinux.cpp
@@ -0,0 +1,558 @@
+/*
+ * Copyright (c) 2026, libgui-wayland contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include "SystemMonitorLinux.h"
+
+#include <AK/JsonObject.h>
+#include <AK/Optional.h>
+#include <AK/QuickSort.h>
+#include <AK/StringBuilder.h>
+#include <AK/StringUtils.h>
+#include <AK/StringView.h>
+#include <AK/Vector.h>
+#include <LibCore/File.h>
+#include <arpa/inet.h>
+#include <dirent.h>
+#include <fcntl.h>
+#include <ifaddrs.h>
+#include <limits.h>
+#include <netinet/in.h>
+#include <sys/mount.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <string.h>
+#include <unistd.h>
+
+namespace SystemMonitor::Linux {
+
+static Optional<ByteString> read_trimmed(ByteString const& path)
+{
+    auto file = Core::File::open(path, Core::File::OpenMode::Read);
+    if (file.is_error())
+        return {};
+    auto contents = file.value()->read_until_eof();
+    if (contents.is_error())
+        return {};
+    return StringView(contents.value().data(), contents.value().size()).trim_whitespace().to_byte_string();
+}
+
+static u64 sysfs_uint(ByteString const& base, StringView name)
+{
+    auto text = read_trimmed(ByteString::formatted("{}/{}", base, name));
+    if (!text.has_value())
+        return 0;
+    return StringView(text.value()).to_number<u64>().value_or(0);
+}
+
+static i32 sysfs_int(ByteString const& base, StringView name)
+{
+    auto text = read_trimmed(ByteString::formatted("{}/{}", base, name));
+    if (!text.has_value())
+        return 0;
+    return StringView(text.value()).to_number<i32>().value_or(0);
+}
+
+static Vector<StringView> split_whitespace(StringView text)
+{
+    Vector<StringView> fields;
+    size_t i = 0;
+    while (i < text.length()) {
+        while (i < text.length() && (text[i] == ' ' || text[i] == '\t'))
+            ++i;
+        size_t start = i;
+        while (i < text.length() && text[i] != ' ' && text[i] != '\t')
+            ++i;
+        if (i > start)
+            fields.append(text.substring_view(start, i - start));
+    }
+    return fields;
+}
+
+// The procfs socket tables encode the address as hex. Notably the value parses
+// to the bytes *as stored* in the sockaddr: "0100007F" (127.0.0.1) and the
+// 4-word IPv6 form "00000000000000000000000001000000" (::1) both decode by
+// taking the parsed integer's little-endian bytes in order.
+static ByteString decode_address(StringView hex)
+{
+    char buffer[INET6_ADDRSTRLEN] = { 0 };
+    if (hex.length() == 8) {
+        auto value = AK::StringUtils::convert_to_uint_from_hex<u32>(hex);
+        if (!value.has_value())
+            return {};
+        in_addr address {};
+        address.s_addr = value.value();
+        inet_ntop(AF_INET, &address, buffer, sizeof(buffer));
+        return ByteString(buffer);
+    }
+    if (hex.length() == 32) {
+        in6_addr address {};
+        for (size_t word = 0; word < 4; ++word) {
+            auto value = AK::StringUtils::convert_to_uint_from_hex<u32>(hex.substring_view(word * 8, 8));
+            if (!value.has_value())
+                return {};
+            memcpy(address.s6_addr + word * 4, &value.value(), 4);
+        }
+        inet_ntop(AF_INET6, &address, buffer, sizeof(buffer));
+        return ByteString(buffer);
+    }
+    return {};
+}
+
+static ByteString socket_state_name(u16 state)
+{
+    switch (state) {
+    case 0x01:
+        return "Established";
+    case 0x02:
+        return "SynSent";
+    case 0x03:
+        return "SynRecv";
+    case 0x04:
+        return "FinWait1";
+    case 0x05:
+        return "FinWait2";
+    case 0x06:
+        return "TimeWait";
+    case 0x07:
+        return "Close";
+    case 0x08:
+        return "CloseWait";
+    case 0x09:
+        return "LastAck";
+    case 0x0A:
+        return "Listen";
+    case 0x0B:
+        return "Closing";
+    default:
+        return ByteString::formatted("0x{:02X}", state);
+    }
+}
+
+ErrorOr<JsonArray> network_adapters()
+{
+    struct Adapter {
+        ByteString name;
+        ByteString ipv4_address;
+        ByteString ipv6_address;
+    };
+    Vector<Adapter> adapters;
+    auto ensure = [&](ByteString const& name) -> Adapter& {
+        for (auto& adapter : adapters) {
+            if (adapter.name == name)
+                return adapter;
+        }
+        adapters.append({ name, {}, {} });
+        return adapters.last();
+    };
+
+    struct ifaddrs* ifaddr = nullptr;
+    if (getifaddrs(&ifaddr) == 0) {
+        for (auto* ifa = ifaddr; ifa; ifa = ifa->ifa_next) {
+            if (!ifa->ifa_name || !ifa->ifa_addr)
+                continue;
+            auto& adapter = ensure(ifa->ifa_name);
+            char buffer[INET6_ADDRSTRLEN] = { 0 };
+            if (ifa->ifa_addr->sa_family == AF_INET) {
+                auto* address = reinterpret_cast<sockaddr_in*>(ifa->ifa_addr);
+                if (inet_ntop(AF_INET, &address->sin_addr, buffer, sizeof(buffer)))
+                    adapter.ipv4_address = buffer;
+            } else if (ifa->ifa_addr->sa_family == AF_INET6) {
+                auto* address = reinterpret_cast<sockaddr_in6*>(ifa->ifa_addr);
+                if (inet_ntop(AF_INET6, &address->sin6_addr, buffer, sizeof(buffer)))
+                    adapter.ipv6_address = buffer;
+            }
+        }
+        freeifaddrs(ifaddr);
+    }
+
+    JsonArray array;
+    for (auto& adapter : adapters) {
+        auto const base = ByteString::formatted("/sys/class/net/{}", adapter.name);
+        auto const operstate = read_trimmed(ByteString::formatted("{}/operstate", base)).value_or(ByteString {});
+        auto const link_up = operstate == "up"sv || operstate == "unknown"sv;
+        auto const duplex = read_trimmed(ByteString::formatted("{}/duplex", base)).value_or(ByteString {});
+        auto const mac_address = read_trimmed(ByteString::formatted("{}/address", base)).value_or(ByteString {});
+
+        // The device's "class": the driver name, when one is bound.
+        ByteString class_name;
+        char driver_path[PATH_MAX] = { 0 };
+        auto const driver_link = ByteString::formatted("{}/device/driver", base);
+        if (auto length = readlink(driver_link.characters(), driver_path, sizeof(driver_path) - 1); length > 0) {
+            driver_path[length] = '\0';
+            StringView driver_view(driver_path, static_cast<size_t>(length));
+            auto last_slash = driver_view.find_last('/');
+            class_name = last_slash.has_value() ? driver_view.substring_view(*last_slash + 1).to_byte_string() : driver_view.to_byte_string();
+        }
+
+        JsonObject object;
+        object.set("name", adapter.name);
+        object.set("class_name", class_name);
+        object.set("mac_address", mac_address);
+        object.set("link_up", link_up);
+        object.set("link_speed", sysfs_int(base, "speed"sv));
+        object.set("link_full_duplex", duplex == "full"sv);
+        object.set("ipv4_address", adapter.ipv4_address);
+        object.set("ipv6_address", adapter.ipv6_address);
+        object.set("packets_in", sysfs_uint(base, "statistics/rx_packets"sv));
+        object.set("packets_out", sysfs_uint(base, "statistics/tx_packets"sv));
+        object.set("bytes_in", sysfs_uint(base, "statistics/rx_bytes"sv));
+        object.set("bytes_out", sysfs_uint(base, "statistics/tx_bytes"sv));
+        object.set("packets_dropped", sysfs_uint(base, "statistics/rx_dropped"sv) + sysfs_uint(base, "statistics/tx_dropped"sv));
+        TRY(array.append(move(object)));
+    }
+    return array;
+}
+
+static ErrorOr<JsonArray> parse_sockets(ByteString const& path)
+{
+    JsonArray array;
+
+    auto file = Core::File::open(path, Core::File::OpenMode::Read);
+    if (file.is_error())
+        return array;
+    auto contents = file.value()->read_until_eof();
+    if (contents.is_error())
+        return array;
+
+    StringView text(contents.value().data(), contents.value().size());
+    bool first_line = true;
+    for (auto line : text.split_view('\n')) {
+        if (first_line) {
+            first_line = false;
+            continue;
+        }
+        auto fields = split_whitespace(line);
+        // sl local_address rem_address st ...
+        if (fields.size() < 4)
+            continue;
+
+        auto endpoint = [](StringView field, ByteString& address, u16& port) {
+            auto colon = field.find(':');
+            if (!colon.has_value())
+                return;
+            address = decode_address(field.substring_view(0, *colon));
+            port = AK::StringUtils::convert_to_uint_from_hex<u16>(field.substring_view(*colon + 1)).value_or(0);
+        };
+
+        ByteString local_address, peer_address;
+        u16 local_port = 0, peer_port = 0;
+        endpoint(fields[1], local_address, local_port);
+        endpoint(fields[2], peer_address, peer_port);
+        auto state = AK::StringUtils::convert_to_uint_from_hex<u16>(fields[3]).value_or(0);
+
+        JsonObject object;
+        object.set("local_address", local_address);
+        object.set("local_port", local_port);
+        object.set("peer_address", peer_address);
+        object.set("peer_port", peer_port);
+        object.set("state", socket_state_name(state));
+        // The Linux procfs socket tables do not expose these counters; report
+        // zeroes rather than SerenityOS's per-socket statistics.
+        object.set("ack_number", 0);
+        object.set("sequence_number", 0);
+        object.set("packets_in", 0);
+        object.set("packets_out", 0);
+        object.set("bytes_in", 0);
+        object.set("bytes_out", 0);
+        TRY(array.append(move(object)));
+    }
+    return array;
+}
+
+ErrorOr<JsonArray> tcp_sockets()
+{
+    auto array = TRY(parse_sockets("/proc/net/tcp"sv));
+    auto tcp6 = TRY(parse_sockets("/proc/net/tcp6"sv));
+    for (auto& row : tcp6.values())
+        TRY(array.append(row));
+    return array;
+}
+
+ErrorOr<JsonArray> udp_sockets()
+{
+    auto array = TRY(parse_sockets("/proc/net/udp"sv));
+    auto udp6 = TRY(parse_sockets("/proc/net/udp6"sv));
+    for (auto& row : udp6.values())
+        TRY(array.append(row));
+    return array;
+}
+
+// /proc/mounts escapes spaces/tabs/newlines/backslashes as octal sequences.
+static ByteString unescape_mount_path(StringView text)
+{
+    StringBuilder builder;
+    for (size_t i = 0; i < text.length(); ++i) {
+        if (text[i] == '\\' && i + 3 < text.length()) {
+            auto octal = text.substring_view(i + 1, 3);
+            if (auto value = AK::StringUtils::convert_to_uint_from_octal<u8>(octal); value.has_value()) {
+                builder.append(static_cast<char>(value.value()));
+                i += 3;
+                continue;
+            }
+        }
+        builder.append(text[i]);
+    }
+    return builder.to_byte_string();
+}
+
+ErrorOr<JsonArray> file_systems()
+{
+    JsonArray array;
+
+    auto file = Core::File::open("/proc/mounts"sv, Core::File::OpenMode::Read);
+    if (file.is_error())
+        return array;
+    auto contents = file.value()->read_until_eof();
+    if (contents.is_error())
+        return array;
+
+    StringView text(contents.value().data(), contents.value().size());
+    for (auto line : text.split_view('\n')) {
+        auto fields = split_whitespace(line);
+        if (fields.size() < 4)
+            continue;
+
+        auto source = unescape_mount_path(fields[0]);
+        auto mount_point = unescape_mount_path(fields[1]);
+        auto class_name = fields[2].to_byte_string();
+        auto options = fields[3];
+
+        bool readonly = false;
+        int mount_flags = 0;
+        for (auto option : options.split_view(',')) {
+            if (option == "ro"sv) {
+                readonly = true;
+                mount_flags |= MS_RDONLY;
+            } else if (option == "nodev"sv) {
+                mount_flags |= MS_NODEV;
+            } else if (option == "noexec"sv) {
+                mount_flags |= MS_NOEXEC;
+            } else if (option == "nosuid"sv) {
+                mount_flags |= MS_NOSUID;
+            }
+        }
+
+        u64 total_block_count = 0;
+        u64 free_block_count = 0;
+        u64 block_size = 0;
+        u64 free_inode_count = 0;
+        u64 total_inode_count = 0;
+        struct statvfs stats {
+        };
+        if (statvfs(mount_point.characters(), &stats) == 0) {
+            total_block_count = stats.f_blocks;
+            free_block_count = stats.f_bfree;
+            block_size = stats.f_frsize != 0 ? stats.f_frsize : stats.f_bsize;
+            free_inode_count = stats.f_ffree;
+            total_inode_count = stats.f_files;
+        }
+
+        JsonObject object;
+        object.set("mount_point", mount_point);
+        object.set("class_name", class_name);
+        object.set("source", source);
+        object.set("total_block_count", total_block_count);
+        object.set("free_block_count", free_block_count);
+        object.set("block_size", block_size);
+        object.set("readonly", readonly);
+        object.set("mount_flags", mount_flags);
+        object.set("free_inode_count", free_inode_count);
+        object.set("total_inode_count", total_inode_count);
+        TRY(array.append(move(object)));
+    }
+    return array;
+}
+
+ErrorOr<JsonArray> process_file_descriptors(pid_t pid)
+{
+    JsonArray array;
+
+    auto directory = opendir(ByteString::formatted("/proc/{}/fd", pid).characters());
+    if (!directory)
+        return array;
+
+    Vector<i32> descriptors;
+    while (auto* entry = readdir(directory)) {
+        if (entry->d_name[0] == '.')
+            continue;
+        if (auto number = StringView(entry->d_name, strlen(entry->d_name)).to_number<i32>(); number.has_value())
+            descriptors.append(number.value());
+    }
+    closedir(directory);
+
+    quick_sort(descriptors);
+
+    for (auto fd : descriptors) {
+        auto const link_path = ByteString::formatted("/proc/{}/fd/{}", pid, fd);
+
+        ByteString absolute_path;
+        char target[PATH_MAX] = { 0 };
+        if (auto length = readlink(link_path.characters(), target, sizeof(target) - 1); length > 0)
+            absolute_path = ByteString(target, static_cast<size_t>(length));
+
+        ByteString class_name;
+        bool seekable = false;
+        struct stat file_stat {
+        };
+        if (stat(link_path.characters(), &file_stat) == 0) {
+            if (S_ISREG(file_stat.st_mode))
+                class_name = "File", seekable = true;
+            else if (S_ISDIR(file_stat.st_mode))
+                class_name = "Directory";
+            else if (S_ISCHR(file_stat.st_mode))
+                class_name = "CharacterDevice";
+            else if (S_ISBLK(file_stat.st_mode))
+                class_name = "BlockDevice";
+            else if (S_ISFIFO(file_stat.st_mode))
+                class_name = "FIFO";
+            else if (S_ISSOCK(file_stat.st_mode))
+                class_name = "Socket";
+            else
+                class_name = "File";
+        } else if (absolute_path.starts_with("socket:"sv)) {
+            class_name = "Socket";
+        } else if (absolute_path.starts_with("pipe:"sv)) {
+            class_name = "FIFO";
+        } else if (absolute_path.starts_with("anon_inode:"sv)) {
+            class_name = "Anonymous";
+        }
+
+        i64 offset = 0;
+        bool blocking = true;
+        bool cloexec = false;
+        bool can_read = true;
+        bool can_write = true;
+        if (auto info = read_trimmed(ByteString::formatted("/proc/{}/fdinfo/{}", pid, fd)); info.has_value()) {
+            for (auto line : StringView(info.value()).split_view('\n')) {
+                auto fields = split_whitespace(line);
+                if (fields.size() < 2)
+                    continue;
+                if (fields[0] == "pos:"sv) {
+                    offset = fields[1].to_number<i64>().value_or(0);
+                } else if (fields[0] == "flags:"sv) {
+                    auto flags = AK::StringUtils::convert_to_uint_from_octal<u32>(fields[1]).value_or(0);
+                    auto access_mode = flags & O_ACCMODE;
+                    can_read = access_mode != O_WRONLY;
+                    can_write = access_mode != O_RDONLY;
+                    blocking = !(flags & O_NONBLOCK);
+                    cloexec = (flags & O_CLOEXEC) != 0;
+                }
+            }
+        }
+
+        JsonObject object;
+        object.set("fd", fd);
+        object.set("class", class_name);
+        object.set("offset", offset);
+        object.set("absolute_path", absolute_path);
+        object.set("seekable", seekable);
+        object.set("blocking", blocking);
+        object.set("cloexec", cloexec);
+        object.set("can_read", can_read);
+        object.set("can_write", can_write);
+        TRY(array.append(move(object)));
+    }
+
+    return array;
+}
+
+ErrorOr<JsonArray> process_memory_map(pid_t pid)
+{
+    JsonArray array;
+
+    auto smaps = read_trimmed(ByteString::formatted("/proc/{}/smaps", pid));
+    bool have_stats = smaps.has_value();
+    if (!smaps.has_value())
+        smaps = read_trimmed(ByteString::formatted("/proc/{}/maps", pid));
+    if (!smaps.has_value())
+        return array;
+
+    struct Region {
+        u64 address { 0 };
+        u64 size { 0 };
+        u64 resident { 0 };
+        u64 dirty { 0 };
+        u64 shared_dirty { 0 };
+        bool readable { false };
+        bool writable { false };
+        bool executable { false };
+        bool shared { false };
+        ByteString name;
+    };
+    Vector<Region> regions;
+
+    for (auto line : StringView(smaps.value()).split_view('\n')) {
+        if (line.is_empty())
+            continue;
+        auto fields = split_whitespace(line);
+        if (fields.is_empty())
+            continue;
+
+        // A mapping header starts with "start-end perms ..."; a stat line is
+        // "Key:  <value> kB".
+        bool is_header = fields.size() >= 5 && fields[0].contains('-') && fields[1].length() == 4
+            && (fields[1].ends_with('p') || fields[1].ends_with('s'));
+        if (is_header) {
+            auto const dash = fields[0].find('-').value();
+            auto start = AK::StringUtils::convert_to_uint_from_hex<u64>(fields[0].substring_view(0, dash)).value_or(0);
+            auto end = AK::StringUtils::convert_to_uint_from_hex<u64>(fields[0].substring_view(dash + 1)).value_or(0);
+            Region region;
+            region.address = start;
+            region.size = end > start ? end - start : 0;
+            auto const& permissions = fields[1];
+            region.readable = permissions[0] == 'r';
+            region.writable = permissions[1] == 'w';
+            region.executable = permissions[2] == 'x';
+            region.shared = permissions[3] == 's';
+            if (fields.size() > 5) {
+                StringBuilder name;
+                for (size_t i = 5; i < fields.size(); ++i) {
+                    if (i > 5)
+                        name.append(' ');
+                    name.append(fields[i]);
+                }
+                region.name = name.to_byte_string();
+            }
+            TRY(regions.try_append(move(region)));
+        } else if (have_stats && !regions.is_empty() && fields[0].ends_with(':')) {
+            auto& region = regions.last();
+            if (fields[0] == "Rss:"sv) {
+                region.resident = fields[1].to_number<u64>().value_or(0) * 1024;
+            } else if (fields[0] == "Shared_Dirty:"sv) {
+                region.shared_dirty = fields[1].to_number<u64>().value_or(0) * 1024;
+                region.dirty += region.shared_dirty;
+            } else if (fields[0] == "Private_Dirty:"sv) {
+                region.dirty += fields[1].to_number<u64>().value_or(0) * 1024;
+            }
+        }
+    }
+
+    for (auto& region : regions) {
+        auto name = region.name.is_empty() ? ByteString("[anon]") : region.name;
+        JsonObject object;
+        object.set("address", region.address);
+        object.set("size", region.size);
+        object.set("amount_resident", region.resident);
+        object.set("amount_dirty", region.dirty);
+        object.set("readable", region.readable);
+        object.set("writable", region.writable);
+        object.set("executable", region.executable);
+        object.set("shared", region.shared);
+        object.set("syscall", StringView(name) == "[vsyscall]"sv);
+        object.set("stack", StringView(name) == "[stack]"sv);
+        object.set("vmobject", ByteString(region.name.starts_with("/"sv) ? "File" : "Anonymous"));
+        object.set("volatile", false);
+        object.set("pagemap", ByteString {});
+        object.set("cow_pages", region.shared_dirty / 4096);
+        object.set("name", name);
+        TRY(array.append(move(object)));
+    }
+
+    return array;
+}
+
+}
