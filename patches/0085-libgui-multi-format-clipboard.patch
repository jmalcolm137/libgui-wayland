+namespace GUI {
+
+// One representation of the clipboard contents. A clipboard item may carry several of these at once: a copied
+// fragment of rich text is usually text/plain and text/html together, and an image may additionally carry a file
+// list. The portal stores the list; consumers pick the representation they understand.
+struct ClipboardEntry {
+    ByteBuffer data;
+    ByteString mime_type;
+    HashMap<ByteString, ByteString> metadata;
+
+    RefPtr<Gfx::Bitmap> as_bitmap() const;
+
+    static ErrorOr<ClipboardEntry> from_json(JsonObject const&);
+    ErrorOr<JsonObject> to_json() const;
+};
+
+}
+
+namespace IPC {
+
+template<>
+inline ErrorOr<void> encode(Encoder& encoder, GUI::ClipboardEntry const& entry)
+{
+    TRY(encoder.encode(entry.data));
+    TRY(encoder.encode(entry.mime_type));
+    TRY(encoder.encode(entry.metadata));
+    return {};
+}
+
+template<>
+inline ErrorOr<GUI::ClipboardEntry> decode(Decoder& decoder)
+{
+    auto data = TRY(decoder.decode<ByteBuffer>());
+    auto mime_type = TRY(decoder.decode<ByteString>());
+    using Metadata = HashMap<ByteString, ByteString>;
+    auto metadata = TRY(decoder.decode<Metadata>());
+    return GUI::ClipboardEntry { move(data), move(mime_type), move(metadata) };
+}
+
+}
