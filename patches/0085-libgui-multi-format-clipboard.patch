-void Storage::set_data(Core::AnonymousBuffer data, ByteString const& mime_type, HashMap<ByteString, ByteString> const& metadata)
+static bool mime_is_plain_text(StringView mime_type)
 {
-    m_buffer = move(data);
-    m_data_size = data.size();
-    m_mime_type = mime_type;
-    m_metadata = metadata;
+    return mime_type == "text/plain"sv || mime_type.starts_with("text/plain;"sv) || mime_type == "UTF8_STRING"sv || mime_type == "STRING"sv;
+}
+
+GUI::ClipboardEntry const* Storage::primary_entry() const
+{
+    GUI::ClipboardEntry const* first = nullptr;
+
+    for (auto const& entry : m_entries) {
+        if (entry.data.is_empty())
+            continue;
+        if (!first)
+            first = &entry;
+        if (mime_is_plain_text(entry.mime_type))
+            return &entry;
+    }
+
+    for (auto const& entry : m_entries) {
+        if (entry.data.is_empty())
+            continue;
+        if (entry.mime_type == "text/html"sv || entry.mime_type.starts_with("text/html;"sv))
+            return &entry;
+    }
+
+    for (auto const& entry : m_entries) {
+        if (entry.data.is_empty())
+            continue;
+        if (entry.mime_type == "text/uri-list"sv)
+            return &entry;
+    }
+
+    for (auto const& entry : m_entries) {
+        if (entry.data.is_empty())
+            continue;
+        if (entry.mime_type.starts_with("image/"sv))
+            return &entry;
+    }
+
+    return first;
+}
+
+bool Storage::has_data() const
+{
+    for (auto const& entry : m_entries) {
+        if (!entry.data.is_empty())
+            return true;
+    }
+    return false;
+}
+
+ByteString Storage::mime_type() const
+{
+    if (auto const* primary = primary_entry())
+        return primary->mime_type;
+    return {};
+}
+
+void Storage::set_entries(Vector<GUI::ClipboardEntry> entries)
+{
+    m_entries = move(entries);
 
     if (on_content_change)
         on_content_change();
