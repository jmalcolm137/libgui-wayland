 void ConnectionFromClient::set_clipboard_data(Core::AnonymousBuffer const& data, ByteString const& mime_type, HashMap<ByteString, ByteString> const& metadata)
 {
-    Storage::the().set_data(data, mime_type, metadata);
+    ByteBuffer bytes;
+    if (data.is_valid()) {
+        auto copied = ByteBuffer::copy(data.data<void>(), data.size());
+        if (copied.is_error())
+            return;
+        bytes = copied.release_value();
+    }
+
+    Vector<GUI::ClipboardEntry> entries;
+    entries.append({ move(bytes), mime_type, metadata });
+    set_clipboard_entries(entries);
+}
+
+void ConnectionFromClient::set_clipboard_entries(Vector<GUI::ClipboardEntry> const& entries)
+{
+    Storage::the().set_entries(entries);
+}
+
+Messages::ClipboardServer::GetClipboardEntriesResponse ConnectionFromClient::get_clipboard_entries()
+{
+    auto entries = Storage::the().entries();
+    return { move(entries) };
 }
 
 Messages::ClipboardServer::GetClipboardDataResponse ConnectionFromClient::get_clipboard_data()
 {
-    auto& storage = Storage::the();
-    return { storage.buffer(), storage.mime_type(), storage.metadata().clone().release_value_but_fixme_should_propagate_errors() };
+    auto const* primary = Storage::the().primary_entry();
+    if (!primary)
+        return { Core::AnonymousBuffer {}, ByteString {}, HashMap<ByteString, ByteString> {} };
+
+    if (primary->data.is_empty())
+        return { Core::AnonymousBuffer {}, primary->mime_type, primary->metadata };
+
+    auto buffer = Core::AnonymousBuffer::create_with_size(primary->data.size());
+    if (buffer.is_error())
+        return { Core::AnonymousBuffer {}, primary->mime_type, primary->metadata };
+    memcpy(buffer.value().data<void>(), primary->data.data(), primary->data.size());
+    return { buffer.release_value(), primary->mime_type, primary->metadata };
 }
 
