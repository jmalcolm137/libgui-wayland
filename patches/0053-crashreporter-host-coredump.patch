+
+#if !defined(AK_OS_SERENITY)
+// The header of an ELF note (Elf64_Nhdr/Elf32_Nhdr are both three u32s). The
+// host's <elf.h> cannot be used here because it collides with Serenity's ELFABI.
+struct HostNoteHeader {
+    u32 namesz;
+    u32 descsz;
+    u32 type;
+};
+struct HostFileEntry {
+    u64 start;
+    u64 end;
+    u64 file_offset;
+};
+
+// Parse a Linux ELF core dump: the standard notes carry the threads, the process
+// info and the file mappings, and the PT_LOAD segments carry the memory.
+void Reader::parse_host_core()
+{
+    struct Note {
+        u32 type;
+        ReadonlyBytes desc;
+    };
+    Vector<Note> notes;
+    Vector<HostFileEntry> file_entries;
+    Vector<ByteString> file_names;
+
+    m_coredump_image.for_each_program_header([&](auto pheader) {
+        if (pheader.type() != PT_NOTE)
+            return;
+        auto const* base = reinterpret_cast<u8 const*>(pheader.raw_data());
+        size_t const size = pheader.size_in_memory();
+        size_t offset = 0;
+        while (offset + sizeof(HostNoteHeader) <= size) {
+            HostNoteHeader header {};
+            memcpy(&header, base + offset, sizeof(header));
+            size_t const name_padded = (static_cast<size_t>(header.namesz) + 3) & ~static_cast<size_t>(3);
+            size_t const desc_padded = (static_cast<size_t>(header.descsz) + 3) & ~static_cast<size_t>(3);
+            size_t const desc_offset = offset + sizeof(HostNoteHeader) + name_padded;
+            if (desc_offset + header.descsz > size)
+                break;
+            notes.append(Note { header.type, ReadonlyBytes { base + desc_offset, header.descsz } });
+            offset = desc_offset + desc_padded;
+        }
+    });
+
+    for (auto const& note : notes) {
+        if (note.type == NT_FILE) {
+            if (note.desc.size() < 2 * sizeof(u64))
+                continue;
+            u64 count = 0;
+            memcpy(&count, note.desc.data(), sizeof(count));
+            size_t const entries_offset = 2 * sizeof(u64);
+            if (entries_offset + count * sizeof(HostFileEntry) > note.desc.size())
+                continue;
+            for (u64 i = 0; i < count; ++i) {
+                HostFileEntry entry {};
+                memcpy(&entry, note.desc.data() + entries_offset + i * sizeof(HostFileEntry), sizeof(entry));
+                file_entries.append(entry);
+            }
+            size_t name_offset = entries_offset + count * sizeof(HostFileEntry);
+            while (name_offset < note.desc.size()) {
+                auto const* string = reinterpret_cast<char const*>(note.desc.data() + name_offset);
+                size_t const length = strnlen(string, note.desc.size() - name_offset);
+                file_names.append(ByteString { StringView { string, length } });
+                name_offset += length + 1;
+            }
+        } else if (note.type == NT_PRSTATUS) {
+            if (note.desc.size() < sizeof(prstatus_t))
+                continue;
+            prstatus_t status {};
+            memcpy(&status, note.desc.data(), sizeof(status));
+            static_assert(sizeof(PtraceRegisters) <= sizeof(status.pr_reg));
+            ELF::Core::ThreadInfo thread {};
+            thread.header.type = ELF::Core::NotesEntryHeader::ThreadInfo;
+            thread.tid = status.pr_pid;
+            memcpy(&thread.regs, &status.pr_reg, sizeof(PtraceRegisters));
+            m_host_threads.append(thread);
+            if (m_host_pid == 0)
+                m_host_pid = status.pr_pid;
+            if (m_host_signal == 0 && status.pr_cursig != 0)
+                m_host_signal = static_cast<u8>(status.pr_cursig);
+        } else if (note.type == NT_PRPSINFO) {
+            if (note.desc.size() < sizeof(prpsinfo_t))
+                continue;
+            prpsinfo_t info {};
+            memcpy(&info, note.desc.data(), sizeof(info));
+            m_host_pid = info.pr_pid;
+            if (m_host_executable.is_empty())
+                m_host_executable = ByteString { StringView { info.pr_fname, strnlen(info.pr_fname, sizeof(info.pr_fname)) } };
+            StringView const args { info.pr_psargs, strnlen(info.pr_psargs, sizeof(info.pr_psargs)) };
+            args.for_each_split_view(" "sv, SplitBehavior::Nothing, [&](StringView arg) {
+                if (!arg.is_empty())
+                    m_host_arguments.append(arg);
+            });
+        } else if (note.type == NT_SIGINFO) {
+            if (note.desc.size() < 24)
+                continue;
+            int signal_number = 0;
+            memcpy(&signal_number, note.desc.data(), sizeof(signal_number));
+            // siginfo_t: si_signo(4) si_errno(4) si_code(4) pad(4) then the
+            // fault address at offset 16.
+            FlatPtr fault_address = 0;
+            memcpy(&fault_address, note.desc.data() + 16, sizeof(fault_address));
+            if (signal_number != 0)
+                m_host_signal = static_cast<u8>(signal_number);
+            if (fault_address != 0)
+                m_host_fault_address = fault_address;
+        } else if (note.type == NT_AUXV) {
+            for (size_t offset = 0; offset + 2 * sizeof(u64) <= note.desc.size(); offset += 2 * sizeof(u64)) {
+                u64 type = 0, value = 0;
+                memcpy(&type, note.desc.data() + offset, sizeof(type));
+                memcpy(&value, note.desc.data() + offset + sizeof(u64), sizeof(value));
+                if (type == 0)
+                    break;
+                if (type == AT_EXECFN && value != 0) {
+                    // The auxiliary vector holds a pointer into the (dumped)
+                    // stack; read the NUL-terminated string through the image.
+                    StringBuilder builder;
+                    FlatPtr cursor = value;
+                    bool terminated = false;
+                    while (!terminated) {
+                        auto word = peek_memory(cursor);
+                        if (!word.has_value())
+                            break;
+                        auto const* bytes = reinterpret_cast<u8 const*>(&word.value());
+                        for (size_t i = 0; i < sizeof(FlatPtr); ++i) {
+                            if (bytes[i] == 0) {
+                                terminated = true;
+                                break;
+                            }
+                            builder.append(static_cast<char>(bytes[i]));
+                        }
+                        cursor += sizeof(FlatPtr);
+                    }
+                    if (!builder.is_empty())
+                        m_host_executable = builder.to_byte_string();
+                }
+            }
+        }
+    }
+
+    // The first NT_FILE entry is the main executable.
+    if (!file_names.is_empty())
+        m_host_executable = file_names.first();
+
+    // PT_LOAD segments become the memory regions, named from NT_FILE.
+    m_coredump_image.for_each_program_header([&](auto pheader) {
+        if (pheader.type() != PT_LOAD || pheader.size_in_memory() == 0)
+            return;
+        auto const& raw = pheader.raw_header();
+        HostRegion region;
+        region.start = raw.p_vaddr;
+        region.end = raw.p_vaddr + raw.p_memsz;
+        region.program_header_index = static_cast<u16>(pheader.index());
+        for (size_t i = 0; i < file_entries.size() && i < file_names.size(); ++i) {
+            if (region.start >= file_entries[i].start && region.start < file_entries[i].end) {
+                region.name = file_names[i];
+                break;
+            }
+        }
+        if (region.name.is_empty())
+            region.name = m_host_executable;
+        m_host_regions.append(move(region));
+    });
 }
+#endif
 
