index 6ec367c3..8b988276 100644
--- a/Userland/Libraries/LibCore/SessionManagement.cpp
+++ b/Userland/Libraries/LibCore/SessionManagement.cpp
@@ -7,6 +7,7 @@
 #include <LibCore/Directory.h>
 #include <LibCore/SessionManagement.h>
 #include <LibCore/System.h>
+#include <stdlib.h>
 
 #ifdef AK_OS_SERENITY
 #    include <LibSystem/syscall.h>
@@ -37,6 +38,12 @@ ErrorOr<void> logout(Optional<pid_t> force_sid)
 ErrorOr<ByteString> parse_path_with_sid(StringView general_path, Optional<pid_t> force_sid)
 {
     if (general_path.contains("%sid"sv)) {
+        // A host can relocate the whole per-session runtime directory. This lets
+        // a test use its own session services (on private socket paths) without
+        // touching, or being answered by, a live session. SerenityOS herself has
+        // no such override.
+        if (auto const* session_dir = getenv("SDE_SESSION_DIR"); session_dir && *session_dir)
+            return general_path.replace("/tmp/session/%sid"sv, ByteString(session_dir), ReplaceMode::All);
         pid_t sid = TRY(root_session_id(force_sid));
         return general_path.replace("%sid"sv, ByteString::number(sid), ReplaceMode::All);
     }
