+ByteString Process::resolve_executable_path(StringView path)
+{
+    // SerenityOS installs applications under /bin, but on the host they live
+    // next to the running executable. Map "/bin/X" to that binary when "/bin/X"
+    // does not exist, so unmodified apps can spawn Serenity applications.
+    if (!path.starts_with("/bin/"sv))
+        return path.to_byte_string();
+
+    auto as_byte_string = path.to_byte_string();
+    if (::access(as_byte_string.characters(), X_OK) == 0)
+        return as_byte_string;
+
+    char buffer[4096];
+    auto length = ::readlink("/proc/self/exe", buffer, sizeof(buffer) - 1);
+    if (length <= 0)
+        return as_byte_string;
+    buffer[length] = '\0';
+
+    auto directory = LexicalPath { StringView { buffer, static_cast<size_t>(length) } }.dirname();
+    return ByteString::formatted("{}/{}", directory, LexicalPath(path).basename());
+}
