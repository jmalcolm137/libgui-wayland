+// SDE: the XCursor theme roots (an X11-compatible cursor set), from XCURSOR_PATH
+// or the usual icon directories.
+static Vector<ByteString> xcursor_roots()
+{
+    Vector<ByteString> roots;
+    if (auto const* path = getenv("XCURSOR_PATH"); path && *path) {
+        for (auto& root : ByteString { path }.split(':'))
+            if (!root.is_empty())
+                roots.append(root);
+    } else {
+        if (auto const* home = getenv("HOME"); home && *home) {
+            roots.append(ByteString::formatted("{}/.icons", home));
+            roots.append(ByteString::formatted("{}/.local/share/icons", home));
+        }
+        roots.append("/usr/share/icons"sv);
+        roots.append("/usr/local/share/icons"sv);
+        roots.append("/usr/share/pixmaps"sv);
+    }
+    return roots;
+}
+
+static ByteString xcursor_theme_cursors_dir(ByteString const& theme)
+{
+    for (auto const& root : xcursor_roots()) {
+        auto dir = ByteString::formatted("{}/{}/cursors", root, theme);
+        if (access(dir.characters(), R_OK) == 0)
+            return dir;
+    }
+    return {};
+}
