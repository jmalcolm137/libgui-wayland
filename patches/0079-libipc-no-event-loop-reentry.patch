+
+ErrorOr<void> PosixSocketHelper::wait_for_writable() const
+{
+    if (!is_open())
+        return Error::from_errno(ENOTCONN);
+
+    struct pollfd the_fd = { .fd = m_fd, .events = POLLOUT, .revents = 0 };
+
+    ErrorOr<int> result { 0 };
+    do {
+        result = Core::System::poll({ &the_fd, 1 }, -1);
+    } while (result.is_error() && result.error().code() == EINTR);
+
+    if (result.is_error())
+        return result.release_error();
+
+    if (the_fd.revents & (POLLERR | POLLHUP | POLLNVAL))
+        return Error::from_errno(EPIPE);
+
+    return {};
+}
 
