+void TextEditor::update_selection_rects(TextRange const& range)
+{
+    if (!range.is_valid() || line_count() == 0 || !is_visual_data_up_to_date())
+        return;
+
+    auto normalized = range.normalized();
+    auto first_line = min(normalized.start().line(), line_count() - 1);
+    auto last_line = min(normalized.end().line(), line_count() - 1);
+    for (auto line_index = first_line; line_index <= last_line; ++line_index)
+        update(line_widget_rect(line_index));
+}
