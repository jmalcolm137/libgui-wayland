+// libgui-wayland: host binaries are not linked with Serenity's embedded
+// serenity_icon_{s,m} sections, so map an executable to the named app icon
+// shipped under resource://icons (e.g. /bin/DisplaySettings ->
+// app-display-settings.png).
+static ByteString app_icon_resource_name(StringView executable_path)
+{
+    auto name = LexicalPath { executable_path }.basename();
+    StringBuilder builder;
+    builder.append("app-"sv);
+    for (size_t i = 0; i < name.length(); ++i) {
+        char ch = name[i];
+        bool upper = ch >= 'A' && ch <= 'Z';
+        if (upper && i > 0) {
+            char prev = name[i - 1];
+            bool prev_lower = prev >= 'a' && prev <= 'z';
+            bool prev_upper = prev >= 'A' && prev <= 'Z';
+            bool next_lower = i + 1 < name.length() && name[i + 1] >= 'a' && name[i + 1] <= 'z';
+            if (prev_lower || (prev_upper && next_lower))
+                builder.append('-');
+        }
+        builder.append(upper ? static_cast<char>(ch - 'A' + 'a') : ch);
+    }
+    return builder.to_byte_string();
+}
