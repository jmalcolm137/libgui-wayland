+// libgui-wayland: the host build relocates the Serenity resource root, and
+// FileSystemModel stats/watches the path directly, so the redirect applied to
+// open() at the LibCore seam is not enough here.
+static ByteString wallpapers_directory()
+{
+    if (auto const* root = getenv("SERENITY_RES_ROOT"); root && *root)
+        return ByteString::formatted("{}/wallpapers", root);
+    return ByteString { "/res/wallpapers" };
+}
