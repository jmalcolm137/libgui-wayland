+/*
+ * Copyright (c) 2026, Serenity Desktop Environment contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/ByteString.h>
+#include <AK/HashMap.h>
+#include <AK/NonnullOwnPtr.h>
+#include <AK/Vector.h>
+#include <LibURL/URL.h>
+
+namespace Launch {
+
+// A launch handler: an application that can open some file types and/or URL
+// protocols. Declared by an application's ".af" file ([Launcher] FileTypes=… /
+// MimeTypes=… / Protocols=…).
+struct Handler {
+    ByteString name;
+    ByteString executable;
+    Vector<ByteString> arguments;
+    Vector<ByteString> file_types;
+    Vector<ByteString> mime_types;
+    Vector<ByteString> protocols;
+};
+
+// Resolves a file or URL to the applications that can open it.
+//
+// This is the shared launch-handler resolution used by both libgui-wayland's
+// in-process LaunchServer fallback and the SDE LaunchServer service, so an
+// application's declared handlers behave the same whether or not SDE is
+// running. Keep it dependency-light (LibCore + LibURL only): LibDesktop's
+// AppFile cannot be used here because it pulls in LibGUI.
+class HandlerDatabase {
+public:
+    // Reads the LaunchServer.ini [FileType]/[Protocol] defaults and scans the
+    // application ".af" files for their declared handlers. Paths are resolved
+    // under SERENITY_RES_ROOT when set (the host build), else the SerenityOS
+    // /etc and /res defaults.
+    static ErrorOr<HandlerDatabase> load();
+
+    // The preferred handler's executable for a file/URL, or an empty string when
+    // nothing matches.
+    ByteString default_executable_for_url(URL::URL const& url) const;
+
+    // Every handler that can open the URL, most-preferred first, with the editor
+    // appended as a generic alternate. The shell turns these into "Open with".
+    Vector<ByteString> handlers_for_url(URL::URL const& url) const;
+
+    Vector<Handler> const& app_handlers() const { return m_app_handlers; }
+
+private:
+    HashMap<ByteString, ByteString> m_file_handlers;     // lowercased extension -> executable
+    HashMap<ByteString, ByteString> m_protocol_handlers; // scheme -> executable
+    Vector<Handler> m_app_handlers;
+};
+
+}
