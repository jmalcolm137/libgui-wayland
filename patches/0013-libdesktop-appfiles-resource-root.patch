 #include <LibDesktop/AppFile.h>
 #include <LibFileSystem/FileSystem.h>
 #include <LibGUI/MessageBox.h>
+#include <stdlib.h>
 
 namespace Desktop {
 
+// Serenity installs application files under /res/apps; on the host they live
+// under the resource root. Falls back to the Serenity path when it is not set.
+ByteString AppFile::app_files_directory()
+{
+    if (auto const* res_root = getenv("SERENITY_RES_ROOT"); res_root && *res_root)
+        return ByteString::formatted("{}/apps", res_root);
+    return ByteString { AppFile::APP_FILES_DIRECTORY };
+}
+
 ByteString AppFile::app_file_path_for_app(StringView app_name)
 {
-    return ByteString::formatted("{}/{}.af", APP_FILES_DIRECTORY, app_name);
+    return ByteString::formatted("{}/{}.af", app_files_directory(), app_name);
 }
 
