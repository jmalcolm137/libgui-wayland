 {
-    Core::DirIterator di(directory, Core::DirIterator::SkipDots);
+    auto dir = directory.is_empty() ? app_files_directory() : directory.to_byte_string();
+    Core::DirIterator di(dir, Core::DirIterator::SkipDots);
     if (di.has_error())
         return;
     while (di.has_next()) {
