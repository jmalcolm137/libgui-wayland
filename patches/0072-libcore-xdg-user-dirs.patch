-ByteString StandardPaths::desktop_directory()
+namespace {
+
+struct UserDirEntry {
+    ByteString key;
+    ByteString value;
+};
+
+// Parse $XDG_CONFIG_HOME/user-dirs.dirs (the XDG User Directories spec).
+Vector<UserDirEntry> parse_user_dirs(ByteString const& path)
 {
-    if (auto* desktop_directory = getenv("XDG_DESKTOP_DIR"))
-        return LexicalPath::canonicalized_path(desktop_directory);
+    Vector<UserDirEntry> entries;
+    auto file = Core::File::open(path, Core::File::OpenMode::Read);
+    if (file.is_error())
+        return entries;
+    auto contents = file.value()->read_until_eof();
+    if (contents.is_error())
+        return entries;
 
-    StringBuilder builder;
-    builder.append(home_directory());
-    builder.append("/Desktop"sv);
-    return LexicalPath::canonicalized_path(builder.to_byte_string());
+    auto bytes = contents.release_value();
+    auto home = Core::StandardPaths::home_directory();
+    StringView text { reinterpret_cast<char const*>(bytes.data()), bytes.size() };
+    for (auto line : text.split_view('\n')) {
+        line = line.trim_whitespace();
+        if (line.is_empty() || line.starts_with('#'))
+            continue;
+        auto equals = line.find('=');
+        if (!equals.has_value())
+            continue;
+        auto key = line.substring_view(0, *equals).trim_whitespace();
+        auto value = line.substring_view(*equals + 1).trim_whitespace();
+        if (key.is_empty())
+            continue;
+        if (value.length() >= 2
+            && ((value.starts_with('"') && value.ends_with('"'))
+                || (value.starts_with('\'') && value.ends_with('\''))))
+            value = value.substring_view(1, value.length() - 2);
+
+        // The spec's values are shell-style and use $HOME.
+        auto expanded = value.to_byte_string();
+        if (expanded.starts_with("${HOME}"sv))
+            expanded = ByteString::formatted("{}{}", home, expanded.substring_view(7));
+        else if (expanded.starts_with("$HOME"sv))
+            expanded = ByteString::formatted("{}{}", home, expanded.substring_view(5));
+        entries.append(UserDirEntry { key.to_byte_string(), move(expanded) });
+    }
+    return entries;
 }
 
