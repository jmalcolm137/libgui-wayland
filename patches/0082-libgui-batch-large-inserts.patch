@@ -139,6 +139,11 @@
 
     HashTable<Client*> m_clients;
     bool m_client_notifications_enabled { true };
+    // Bulk document edits defer the per-change notification until the edit is
+    // complete; line insert/remove notifications still reach the clients so
+    // their per-line state stays in sync.
+    bool m_did_change_notifications_deferred { false };
+    bool m_did_change_pending { false };
 
