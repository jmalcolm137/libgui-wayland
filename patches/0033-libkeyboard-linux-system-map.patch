+#else
+// libgui-wayland host build: the system keymap is owned by the display server,
+// not the kernel. The session's selected xkb layout is published to clients in
+// the standard XKB_DEFAULT_LAYOUT environment variable (the first entry of the
+// comma-separated list is the active layout); compositors that do not export it
+// fall back to the us layout. Applying a keymap is a display-server operation
+// (through its own protocol, e.g. the WindowServer keyboard-layout interface),
+// so there is nothing to do here.
+int CharacterMap::set_system_map()
+{
+    return 0;
+}
+
+ErrorOr<CharacterMap> CharacterMap::fetch_system_map()
+{
+    ByteString name { "us"sv };
+    if (auto const* layout = getenv("XKB_DEFAULT_LAYOUT"); layout && *layout) {
+        auto first = StringView(layout, strlen(layout)).split_view(',').first().trim_whitespace();
+        if (!first.is_empty())
+            name = first;
+    }
+    CharacterMapData map_data {};
+    return CharacterMap { name, map_data };
+}
+#endif
 
