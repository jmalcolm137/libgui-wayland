diff --git a/Userland/Services/ImageDecoder/ConnectionFromClient.h b/Userland/Services/ImageDecoder/ConnectionFromClient.h
index 7be87db1..2cb708ad 100644
--- a/Userland/Services/ImageDecoder/ConnectionFromClient.h
+++ b/Userland/Services/ImageDecoder/ConnectionFromClient.h
@@ -25,6 +25,19 @@ public:
 
     virtual void die() override;
 
+    // The upstream ImageDecoder service serves exactly one client and exits when
+    // that client disconnects. An in-process decoder hosted inside a client
+    // process must outlive individual client connections, so it can opt out of
+    // that teardown.
+    void set_exit_when_client_disconnects(bool exit_when_client_disconnects) { m_exit_when_client_disconnects = exit_when_client_disconnects; }
+
+    // A decode job normally runs on the process-global `Threading::BackgroundAction`
+    // thread. A host whose client already occupies that one thread - e.g. LibGUI's
+    // `FileSystemModel` renders thumbnails on it - would deadlock waiting for a job
+    // that can never be scheduled. Such an in-process host decodes inline on the
+    // connection's own thread instead.
+    void set_decode_on_connection_thread(bool decode_on_connection_thread) { m_decode_on_connection_thread = decode_on_connection_thread; }
+
     struct DecodeResult {
         bool is_animated = false;
         u32 loop_count = 0;
@@ -44,6 +57,8 @@ private:
     NonnullRefPtr<Job> make_decode_image_job(i64 image_id, Core::AnonymousBuffer, Optional<Gfx::IntSize> ideal_size, Optional<ByteString> mime_type);
 
     i64 m_next_image_id { 0 };
+    bool m_exit_when_client_disconnects { true };
+    bool m_decode_on_connection_thread { false };
     HashMap<i64, NonnullRefPtr<Job>> m_pending_jobs;
 };
 
