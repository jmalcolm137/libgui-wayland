+++ b/Userland/Libraries/LibGUI/Clipboard.cpp
@@ -7,12 +7,15 @@
 
 #include <Clipboard/ClipboardClientEndpoint.h>
 #include <Clipboard/ClipboardServerEndpoint.h>
+#include <LibCore/EventLoop.h>
 #include <LibGUI/Clipboard.h>
 #include <LibGfx/Bitmap.h>
 #include <LibIPC/ConnectionToServer.h>
 
 namespace GUI {
 
+static void clipboard_connection_died();
+
 class ConnectionToClipboardServer final
     : public IPC::ConnectionToServer<ClipboardClientEndpoint, ClipboardServerEndpoint>
     , public ClipboardClientEndpoint {
@@ -28,12 +31,32 @@
     {
         Clipboard::the().clipboard_data_changed({}, mime_type);
     }
+
+    virtual void die() override
+    {
+        // The clipboard is auxiliary: losing it must not terminate the
+        // application. The default ConnectionToServer::die() calls exit(0),
+        // which used to take the whole Terminal down after a large copy.
+        clipboard_connection_died();
+    }
 };
 
 static RefPtr<ConnectionToClipboardServer> s_connection;
 
+static void clipboard_connection_died()
+{
+    dbgln("GUI::Clipboard: connection to the clipboard server was lost");
+    Core::deferred_invoke([] {
+        s_connection = nullptr;
+    });
+}
+
 static ConnectionToClipboardServer& connection()
 {
+    // The previous connection may have been torn down; reconnect on the next use
+    // rather than exiting or dereferencing a dead connection.
+    if (!s_connection || !s_connection->is_open())
+        s_connection = ConnectionToClipboardServer::try_create().release_value_but_fixme_should_propagate_errors();
     return *s_connection;
 }
 
