 }
 
+void TerminalWidget::clipboard_content_did_change(ByteString const& mime_type)
+{
+    // Do not fetch the clipboard data here. This callback runs inside the
+    // clipboard connection's message dispatch, and the synchronous fetch used to
+    // re-enter that connection. After a large copy the Terminal could lose the
+    // connection and exit. Paste fetches the data when it is actually used.
+    m_paste_action->set_enabled(mime_type.starts_with("text/"sv));
+}
