     Gfx::IntPoint m_mouse_offset {};
     Core::ElapsedTimer m_idle_sleep_timer;
 
+#if defined(AK_OS_SERENITY)
     NonnullOwnPtr<Core::File> m_proc_all;
+#endif
 
     State m_state { State::Roaming };
     State m_last_state { m_state };
