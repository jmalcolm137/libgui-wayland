diff --git a/Userland/Demos/CatDog/CatDog.cpp b/Userland/Demos/CatDog/CatDog.cpp
index afafb624..2cf43b35 100644
--- a/Userland/Demos/CatDog/CatDog.cpp
+++ b/Userland/Demos/CatDog/CatDog.cpp
@@ -57,7 +57,9 @@ ErrorOr<NonnullRefPtr<CatDog>> CatDog::create()
 }
 
 CatDog::CatDog()
+#if defined(AK_OS_SERENITY)
     : m_proc_all(MUST(Core::File::open("/sys/kernel/processes"sv, Core::File::OpenMode::Read)))
+#endif
 {
     m_idle_sleep_timer.start();
 }
@@ -86,7 +88,13 @@ void CatDog::set_sleeping(bool sleeping)
 
 CatDog::State CatDog::special_application_states() const
 {
+#if defined(AK_OS_SERENITY)
     auto maybe_proc_info = Core::ProcessStatisticsReader::get_all(*m_proc_all);
+#else
+    // Linux: the process list comes from /proc (LibCore::ProcessStatisticsReader),
+    // not the SerenityOS kernel's /sys/kernel/processes interface.
+    auto maybe_proc_info = Core::ProcessStatisticsReader::get_all();
+#endif
     if (maybe_proc_info.is_error())
         return State::GenericCatDog;
 
