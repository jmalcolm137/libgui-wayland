 void MonitorSettingsWidget::apply_settings()
 {
-    // libgui-wayland: the host compositor does not implement output configuration
-    // (set_screen_layout is accepted but ignored). Applying the Monitor tab would
-    // only raise SerenityOS's modal "Do you want to keep the new screen layout?
