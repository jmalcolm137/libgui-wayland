-    // it: the Monitor tab is display-only in the port.
-    return;
+    // libgui-wayland/SDE: the host compositor *does* implement output
+    // configuration, via screenlayout.ini: it watches the file and applies
+    // mode/position/scale live. Apply directly and save. We deliberately skip
+    // SerenityOS's "Do you want to keep the new screen layout? Reverting in N
+    // seconds." dialog - SettingsWindow applies every tab, so a modal here would
+    // freeze the window on every Apply.
+    auto result = GUI::ConnectionToWindowServer::the().set_screen_layout(m_screen_layout, true);
+    if (!result.success())
+        GUI::MessageBox::show_error(window(), MUST(String::formatted("Error setting screen layout: {}", result.error_msg())));
+}
+
+void MonitorSettingsWidget::apply_output_scale(double scale)
+{
+    // R6 HiDPI: the scale radios apply immediately (the Monitor tab's Apply is a
+    // no-op in the port). We keep the layout/preview in sync and tell the
+    // compositor the *exact* scale as v120, so fractional values survive the
+    // integer ScreenLayout: the compositor writes them to [Output] DefaultScale,
+    // which it live-applies.
+    int const ceil_scale = static_cast<int>(AK::ceil(scale));
+    int const int_scale = ceil_scale < 1 ? 1 : ceil_scale;
+    if (m_selected_screen_index < m_screen_layout.screens.size()) {
+        auto& selected_screen = m_screen_layout.screens[m_selected_screen_index];
+        selected_screen.scale_factor = int_scale;
+        m_screen_layout.normalize();
+    }
+    m_monitor_widget->set_desktop_scale_factor(int_scale);
+    m_monitor_widget->update();
+    set_modified(true);
+    GUI::ConnectionToWindowServer::the().async_set_output_scale(static_cast<i32>(AK::round(scale * 120.0)));
 }
 
