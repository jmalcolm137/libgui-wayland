@@ -78,7 +78,12 @@ inline ErrorOr<void> unveil(StringView, StringView)
 {
     return {};
 }
+inline ErrorOr<void> unveil_after_exec(StringView, StringView) { return {}; }
 inline ErrorOr<void> pledge(StringView, StringView = {}) { return {}; }
+// libgui-wayland: Serenity-only operations become no-ops on the host.
+inline ErrorOr<void> enter_jail_mode_until_exit() { return {}; }
+inline ErrorOr<void> enter_jail_mode_until_exec() { return {}; }
