 #endif
 
 template<size_t N>
@@ -128,6 +133,12 @@ ErrorOr<void> munmap(void* address, size_t);
 ErrorOr<int> anon_create(size_t size, int options);
 ErrorOr<int> open(StringView path, int options, mode_t mode = 0);
 ErrorOr<int> openat(int fd, StringView path, int options, mode_t mode = 0);
+
+// libgui-wayland: on the host build the Serenity resource root is relocated with
+// SERENITY_RES_ROOT, so absolute "/res/..." paths must be rewritten before they
+// reach libc. Bare syscalls that bypass System::open (opendir, stat) use this.
+// On SerenityOS it is the identity.
+ByteString resolve_resource_path(StringView path);
 ErrorOr<void> close(int fd);
 ErrorOr<void> ftruncate(int fd, off_t length);
 ErrorOr<void> fsync(int fd);
