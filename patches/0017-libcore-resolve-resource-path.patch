diff --git a/Userland/Libraries/LibCore/System.cpp b/Userland/Libraries/LibCore/System.cpp
index 1ff2626b..829110e1 100644
--- a/Userland/Libraries/LibCore/System.cpp
+++ b/Userland/Libraries/LibCore/System.cpp
@@ -596,6 +596,26 @@ ErrorOr<int> open(StringView path, int options, mode_t mode)
     return openat(AT_FDCWD, path, options, mode);
 }
 
+ByteString resolve_resource_path(StringView path)
+{
+#ifdef AK_OS_SERENITY
+    return path;
+#else
+    // Host build: redirect SerenityOS's absolute paths into the bundled Base
+    // tree, so code that hardcodes them works unmodified.
+    //   "/res/..."           -> $SERENITY_RES_ROOT/...   (roots, themes, ...)
+    //   "/usr/share/man/..." -> the SerenityOS man pages, which sit beside the
+    //                          resource root under Base (Help reads them).
+    if (auto const* root = getenv("SERENITY_RES_ROOT"); root && *root) {
+        if (path.starts_with("/res/"sv))
+            return ByteString::formatted("{}{}", root, path.substring_view(4));
+        if (path.starts_with("/usr/share/man/"sv))
+            return ByteString::formatted("{}/../{}", root, path.substring_view(1));
+    }
+    return path;
+#endif
+}
+
 ErrorOr<int> openat(int fd, StringView path, int options, mode_t mode)
 {
     if (!path.characters_without_null_termination())
@@ -607,6 +627,9 @@ ErrorOr<int> openat(int fd, StringView path, int options, mode_t mode)
 #else
     // NOTE: We have to ensure that the path is null-terminated.
     ByteString path_string = path;
+    // Host build: "/res/..." paths are relocated under SERENITY_RES_ROOT.
+    if (fd == AT_FDCWD)
+        path_string = resolve_resource_path(path_string);
     int rc = ::openat(fd, path_string.characters(), options, mode);
     if (rc < 0)
         return Error::from_syscall("open"sv, -errno);
@@ -646,7 +669,7 @@ ErrorOr<struct stat> stat(StringView path)
     int rc = syscall(SC_stat, &params);
     HANDLE_SYSCALL_RETURN_VALUE("stat", rc, st);
 #else
-    ByteString path_string = path;
+    ByteString path_string = resolve_resource_path(path);
     if (::stat(path_string.characters(), &st) < 0)
         return Error::from_syscall("stat"sv, -errno);
     return st;
@@ -664,7 +687,7 @@ ErrorOr<struct stat> lstat(StringView path)
     int rc = syscall(SC_stat, &params);
     HANDLE_SYSCALL_RETURN_VALUE("lstat", rc, st);
 #else
-    ByteString path_string = path;
+    ByteString path_string = resolve_resource_path(path);
     if (::lstat(path_string.characters(), &st) < 0)
         return Error::from_syscall("lstat"sv, -errno);
     return st;
diff --git a/Userland/Libraries/LibCore/System.h b/Userland/Libraries/LibCore/System.h
