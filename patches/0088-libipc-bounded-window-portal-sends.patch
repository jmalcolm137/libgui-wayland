-ErrorOr<void> MessageBuffer::transfer_message(Core::LocalSocket& socket)
+static ErrorOr<bool> wait_for_writable(Core::LocalSocket& socket, int timeout_ms)
+{
+    auto fd = socket.fd();
+    if (!fd.has_value())
+        return Error::from_errno(ENOTCONN);
+
+    struct pollfd pfd {
+        .fd = *fd,
+        .events = POLLOUT,
+        .revents = 0,
+    };
+
+    int result = 0;
+    do {
+        result = ::poll(&pfd, 1, timeout_ms);
+    } while (result < 0 && errno == EINTR);
+
+    if (result < 0)
+        return Error::from_errno(errno);
+    if (result == 0)
+        return false;
+    if (pfd.revents & (POLLERR | POLLHUP | POLLNVAL))
+        return Error::from_errno(EPIPE);
+    return true;
+}
+
