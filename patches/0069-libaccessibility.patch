+    if (result >= 0 && node->source && node->source->is_text)
+        result = sd_bus_message_append(reply, "s", "org.a11y.atspi.Text");
+    if (result >= 0 && node->source && node->source->editable)
+        result = sd_bus_message_append(reply, "s", "org.a11y.atspi.EditableText");
+    if (result >= 0)
+        result = sd_bus_message_close_container(reply);
+    if (result >= 0)
+        result = sd_bus_send(nullptr, reply, nullptr);
+    sd_bus_message_unref(reply);
+    return result;
+}
