+static StringView node_text(DBusServer::FlatNode const* node)
+{
+    if (!node || !node->source)
+        return {};
+    return node->source->text.bytes_as_string_view();
+}
+
+static StringView clamp_slice(StringView text, int start, int end)
+{
+    if (start < 0)
+        start = 0;
+    if (end < 0 || end > static_cast<int>(text.length()))
+        end = text.length();
+    if (end <= start)
+        return {};
+    return text.substring_view(start, end - start);
+}
+
+static int reply_text(sd_bus_message* message, StringView text)
+{
+    auto copy = MUST(String::from_utf8(text));
+    auto bytes = copy.to_byte_string();
+    return sd_bus_reply_method_return(message, "s", bytes.characters());
+}
+
+static int reply_text_with_bounds(sd_bus_message* message, StringView text)
+{
+    auto copy = MUST(String::from_utf8(text));
+    auto bytes = copy.to_byte_string();
+    return sd_bus_reply_method_return(message, "(sii)", bytes.characters(), 0, static_cast<int>(text.length()));
+}
