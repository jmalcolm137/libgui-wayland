+++ b/Userland/Libraries/LibAccessibility/CMakeLists.txt
@@ -0,0 +1,20 @@
+set(SOURCES
+    Server.cpp
+)
+
+# The AT-SPI transport is Linux-only. LibGUI itself stays portable: it talks to
+# the platform-neutral Accessibility::Server API.
+if (BUILD_LAGOM)
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(SDBUS REQUIRED libsystemd)
+    list(APPEND SOURCES Linux/DBusServer.cpp)
+endif()
+
+serenity_lib(LibAccessibility accessibility)
+target_link_libraries(LibAccessibility PRIVATE LibCore LibGfx)
+
+if (BUILD_LAGOM)
+    target_include_directories(LibAccessibility PRIVATE ${SDBUS_INCLUDE_DIRS})
+    target_link_libraries(LibAccessibility PRIVATE ${SDBUS_LIBRARIES})
+    target_compile_definitions(LibAccessibility PRIVATE HAVE_SDBUS=1)
+endif()
diff --git a/Userland/Libraries/LibAccessibility/Linux/DBusServer.cpp b/Userland/Libraries/LibAccessibility/Linux/DBusServer.cpp
new file mode 100644
index 00000000..6f06ac4a
--- /dev/null
+++ b/Userland/Libraries/LibAccessibility/Linux/DBusServer.cpp
@@ -0,0 +1,291 @@
+/*
+ * Copyright (c) 2026, Serenity Desktop Environment contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include "DBusServer.h"
+
+#include <AK/ByteString.h>
+#include <LibCore/EventLoop.h>
+#include <errno.h>
+#include <string.h>
+#include <systemd/sd-bus-vtable.h>
+#include <unistd.h>
+
+namespace Accessibility::Linux {
+
+static constexpr char const* accessible_prefix = "/org/a11y/atspi/accessible";
+static constexpr char const* root_path = "/org/a11y/atspi/accessible/root";
+
+static char const* introspection_xml = R"XML(
+<node>
+  <interface name="org.a11y.atspi.Accessible">
+    <method name="GetRole"><arg direction="out" type="i"/></method>
+    <method name="GetName"><arg direction="out" type="s"/></method>
+    <method name="GetDescription"><arg direction="out" type="s"/></method>
+    <method name="GetChildCount"><arg direction="out" type="i"/></method>
+    <method name="GetChildren"><arg direction="out" type="a(so)"/></method>
+    <method name="GetState"><arg direction="out" type="au"/></method>
+    <method name="GetParent"><arg direction="out" type="(so)"/></method>
+    <method name="GetApplication"><arg direction="out" type="(so)"/></method>
+    <method name="GetInterfaces"><arg direction="out" type="as"/></method>
+  </interface>
+  <interface name="org.freedesktop.DBus.Introspectable">
+    <method name="Introspect"><arg direction="out" type="s"/></method>
+  </interface>
+</node>
+)XML";
+
+DBusServer::DBusServer(Snapshot snapshot)
+    : m_snapshot(move(snapshot))
+{
+    // Only start on the dedicated accessibility bus. The session bus normally
+    // has no AT-SPI registry; registering an application name there makes every
+    // app a bogus accessibility service.
+    char const* address = getenv("AT_SPI_BUS_ADDRESS");
+    if (!address || !*address) {
+        dbgln("Accessibility: no bus address");
+        return;
+    }
+
+    if (sd_bus_new(&m_bus) < 0) {
+        dbgln("Accessibility: sd_bus_new failed");
+        return;
+    }
+    if (sd_bus_set_address(m_bus, address) < 0) {
+        dbgln("Accessibility: sd_bus_set_address failed: {} ({})", address, strerror(errno));
+        sd_bus_unref(m_bus);
+        m_bus = nullptr;
+        return;
+    }
+    if (sd_bus_set_bus_client(m_bus, 1) < 0 || sd_bus_start(m_bus) < 0) {
+        dbgln("Accessibility: sd_bus_start failed: {}", strerror(errno));
+        sd_bus_unref(m_bus);
+        m_bus = nullptr;
+        return;
+    }
+
+    m_bus_name = ByteString::formatted("org.a11y.atspi.App_{}", getpid());
+    int request_result = sd_bus_request_name(m_bus, m_bus_name.characters(), 0);
+    if (request_result < 0) {
+        dbgln("Accessibility: request_name failed: {} ({})", request_result, strerror(-request_result));
+        sd_bus_unref(m_bus);
+        m_bus = nullptr;
+        return;
+    }
+
+    static sd_bus_vtable const vtable[] = {
+        SD_BUS_VTABLE_START(0),
+        SD_BUS_METHOD("GetRole", "", "i", handle_get_role, 0),
+        SD_BUS_METHOD("GetName", "", "s", handle_get_name, 0),
+        SD_BUS_METHOD("GetDescription", "", "s", handle_get_description, 0),
+        SD_BUS_METHOD("GetChildCount", "", "i", handle_get_child_count, 0),
+        SD_BUS_METHOD("GetChildren", "", "a(so)", handle_get_children, 0),
+        SD_BUS_METHOD("GetState", "", "au", handle_get_state, 0),
+        SD_BUS_METHOD("GetParent", "", "(so)", handle_get_parent, 0),
+        SD_BUS_METHOD("GetApplication", "", "(so)", handle_get_application, 0),
+        SD_BUS_METHOD("GetInterfaces", "", "as", handle_get_interfaces, 0),
+        SD_BUS_METHOD("Introspect", "", "s", handle_introspect, 0),
+        SD_BUS_VTABLE_END,
+    };
+    (void)sd_bus_add_object_vtable(m_bus, nullptr, root_path, "org.a11y.atspi.Accessible", vtable, this);
+    (void)sd_bus_add_fallback_vtable(m_bus, nullptr, accessible_prefix, "org.a11y.atspi.Accessible", vtable, nullptr, this);
+
+    dbgln("Accessibility: serving as {}", m_bus_name);
+    m_notifier = Core::Notifier::construct(sd_bus_get_fd(m_bus), Core::Notifier::Type::Read);
+    m_notifier->on_activation = [this] {
+        while (m_bus && sd_bus_process(m_bus, nullptr) > 0) { }
+        if (m_bus)
+            (void)sd_bus_flush(m_bus);
+    };
+}
+
+DBusServer::~DBusServer()
+{
+    if (m_notifier)
+        m_notifier->set_enabled(false);
+    if (m_bus)
+        sd_bus_flush_close_unref(m_bus);
+}
+
+int DBusServer::index_for_path(char const* path)
+{
+    if (!path)
+        return -1;
+    if (!strcmp(path, root_path))
+        return 0;
+    auto const prefix_length = strlen(accessible_prefix);
+    if (strncmp(path, accessible_prefix, prefix_length) != 0)
+        return -1;
+    auto suffix = StringView { path + prefix_length, strlen(path + prefix_length) };
+    if (suffix.starts_with('/'))
+        suffix = suffix.substring_view(1);
+    return suffix.to_number<int>().value_or(-1);
+}
+
+Vector<DBusServer::FlatNode> DBusServer::flatten()
+{
+    Vector<FlatNode> nodes;
+    auto root = m_snapshot();
+
+    Function<void(Node const&, int)> add = [&](Node const& node, int parent) {
+        int const index = nodes.size();
+        FlatNode flat;
+        flat.path = index == 0 ? ByteString { root_path } : ByteString::formatted("{}/{}", accessible_prefix, index);
+        flat.name = node.name;
+        flat.role = node.role;
+        flat.rect = node.rect;
+        flat.states = node.states;
+        flat.parent = parent;
+        nodes.append(move(flat));
+        if (parent >= 0)
+            nodes[parent].children.append(index);
+        for (auto const& child : node.children)
+            add(child, index);
+    };
+
+    add(root, -1);
+    return nodes;
+}
+
+static DBusServer::FlatNode const* node_at(Vector<DBusServer::FlatNode> const& nodes, char const* path)
+{
+    int const index = DBusServer::index_for_path(path);
+    if (index < 0 || index >= static_cast<int>(nodes.size()))
+        return nullptr;
+    return &nodes[index];
+}
+
+static int reply_node_error(sd_bus_message* message)
+{
+    return sd_bus_reply_method_errorf(message, "org.a11y.atspi.Error.Invalid", "No such accessible");
+}
+
+int DBusServer::handle_get_role(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto& server = *static_cast<DBusServer*>(data);
+    auto nodes = server.flatten();
+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    if (!node)
+        return reply_node_error(message);
+    return sd_bus_reply_method_return(message, "i", static_cast<int>(node->role));
+}
+
+int DBusServer::handle_get_name(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto& server = *static_cast<DBusServer*>(data);
+    auto nodes = server.flatten();
+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    if (!node)
+        return reply_node_error(message);
+    return sd_bus_reply_method_return(message, "s", node->name.to_byte_string().characters());
+}
+
+int DBusServer::handle_get_description(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "s", "");
+}
+
+int DBusServer::handle_get_child_count(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto& server = *static_cast<DBusServer*>(data);
+    auto nodes = server.flatten();
+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    if (!node)
+        return reply_node_error(message);
+    return sd_bus_reply_method_return(message, "i", static_cast<int>(node->children.size()));
+}
+
+int DBusServer::handle_get_children(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto& server = *static_cast<DBusServer*>(data);
+    auto nodes = server.flatten();
+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    if (!node)
+        return reply_node_error(message);
+
+    sd_bus_message* reply = nullptr;
+    int result = sd_bus_message_new_method_return(message, &reply);
+    if (result < 0)
+        return result;
+    result = sd_bus_message_open_container(reply, 'a', "(so)");
+    if (result >= 0) {
+        for (int child : node->children) {
+            result = sd_bus_message_append(reply, "(so)", server.m_bus_name.characters(), nodes[child].path.characters());
+            if (result < 0)
+                break;
+        }
+    }
+    if (result >= 0)
+        result = sd_bus_message_close_container(reply);
+    if (result >= 0)
+        result = sd_bus_send(nullptr, reply, nullptr);
+    sd_bus_message_unref(reply);
+    return result;
+}
+
+int DBusServer::handle_get_state(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto& server = *static_cast<DBusServer*>(data);
+    auto nodes = server.flatten();
+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    if (!node)
+        return reply_node_error(message);
+
+    sd_bus_message* reply = nullptr;
+    int result = sd_bus_message_new_method_return(message, &reply);
+    if (result < 0)
+        return result;
+    result = sd_bus_message_open_container(reply, 'a', "u");
+    if (result >= 0) {
+        result = sd_bus_message_append(reply, "u", node->states);
+        if (result >= 0)
+            result = sd_bus_message_close_container(reply);
+    }
+    if (result >= 0)
+        result = sd_bus_send(nullptr, reply, nullptr);
+    sd_bus_message_unref(reply);
+    return result;
+}
+
+int DBusServer::handle_get_parent(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto& server = *static_cast<DBusServer*>(data);
+    auto nodes = server.flatten();
+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    if (!node)
+        return reply_node_error(message);
+    int const parent = node->parent < 0 ? 0 : node->parent;
+    return sd_bus_reply_method_return(message, "(so)", server.m_bus_name.characters(), nodes[parent].path.characters());
+}
+
+int DBusServer::handle_get_application(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto& server = *static_cast<DBusServer*>(data);
+    return sd_bus_reply_method_return(message, "(so)", server.m_bus_name.characters(), root_path);
+}
+
+int DBusServer::handle_get_interfaces(sd_bus_message* message, void*, sd_bus_error*)
+{
+    sd_bus_message* reply = nullptr;
+    int result = sd_bus_message_new_method_return(message, &reply);
+    if (result < 0)
+        return result;
+    result = sd_bus_message_open_container(reply, 'a', "s");
+    if (result >= 0)
+        result = sd_bus_message_append(reply, "s", "org.a11y.atspi.Accessible");
+    if (result >= 0)
+        result = sd_bus_message_close_container(reply);
+    if (result >= 0)
+        result = sd_bus_send(nullptr, reply, nullptr);
+    sd_bus_message_unref(reply);
+    return result;
+}
+
+int DBusServer::handle_introspect(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "s", introspection_xml);
+}
+
+}
