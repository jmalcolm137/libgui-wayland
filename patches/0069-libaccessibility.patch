+/*
+ * Copyright (c) 2026, Serenity Desktop Environment contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <LibAccessibility/Server.h>
+#include <LibCore/Notifier.h>
+#include <systemd/sd-bus.h>
+
+namespace Accessibility::Linux {
+
+class DBusServer final : public Server {
+public:
+    explicit DBusServer(Snapshot);
+    virtual ~DBusServer() override;
+
+    struct FlatNode {
+        ByteString path;
+        String name;
+        Role role { Role::Invalid };
+        Gfx::IntRect rect;
+        u32 states { 0 };
+        int parent { -1 };
+        Vector<int> children;
+    };
+
+    static int index_for_path(char const*);
+
+private:
+    static int handle_get_role(sd_bus_message*, void*, sd_bus_error*);
+    static int handle_get_name(sd_bus_message*, void*, sd_bus_error*);
+    static int handle_get_description(sd_bus_message*, void*, sd_bus_error*);
+    static int handle_get_child_count(sd_bus_message*, void*, sd_bus_error*);
+    static int handle_get_children(sd_bus_message*, void*, sd_bus_error*);
+    static int handle_get_state(sd_bus_message*, void*, sd_bus_error*);
+    static int handle_get_parent(sd_bus_message*, void*, sd_bus_error*);
+    static int handle_get_application(sd_bus_message*, void*, sd_bus_error*);
+    static int handle_get_interfaces(sd_bus_message*, void*, sd_bus_error*);
+    static int handle_introspect(sd_bus_message*, void*, sd_bus_error*);
+
+    Vector<FlatNode> flatten();
+
+    Snapshot m_snapshot;
+    sd_bus* m_bus { nullptr };
+    ByteString m_bus_name;
+    RefPtr<Core::Notifier> m_notifier;
+};
+
+}
