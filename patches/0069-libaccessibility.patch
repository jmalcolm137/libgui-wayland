+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    if (!node || !node->source || !node->source->is_text)
+        return reply_node_error(message);
+    int start = 0;
+    int end = 0;
+    if (sd_bus_message_read(message, "ii", &start, &end) < 0)
+        return -EINVAL;
+    return reply_text(message, clamp_slice(node_text(node), start, end));
+}
