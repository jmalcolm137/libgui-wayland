+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    if (!node || !node->source || !node->source->is_text)
+        return reply_node_error(message);
+    int selection = 0;
+    if (sd_bus_message_read(message, "i", &selection) < 0)
+        return -EINVAL;
+    (void)selection;
+    return sd_bus_reply_method_return(message, "(ii)", 0, 0);
+}
+
+int DBusServer::handle_text_add_selection(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "b", 0);
+}
+
+int DBusServer::handle_text_remove_selection(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "b", 0);
+}
+
+int DBusServer::handle_text_set_selection(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "b", 0);
+}
+
+int DBusServer::handle_text_set_caret_offset(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "b", 0);
+}
+
+int DBusServer::handle_text_scroll_substring_to(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "b", 0);
+}
+
+int DBusServer::handle_text_scroll_substring_to_point(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "b", 0);
+}
+
+int DBusServer::handle_editable_set_text_contents(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto snapshot = static_cast<DBusServer*>(data)->flatten();
+    auto& nodes = snapshot.nodes;
+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    if (!node || !node->source || !node->source->editable || !node->source->set_text)
+        return sd_bus_reply_method_return(message, "b", 0);
+    char const* text = nullptr;
+    if (sd_bus_message_read(message, "s", &text) < 0)
+        return -EINVAL;
+    node->source->set_text(MUST(String::from_utf8(StringView { text, strlen(text) })));
+    return sd_bus_reply_method_return(message, "b", 1);
+}
+
+int DBusServer::handle_editable_insert_text(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto snapshot = static_cast<DBusServer*>(data)->flatten();
+    auto& nodes = snapshot.nodes;
+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    if (!node || !node->source || !node->source->editable || !node->source->set_text)
+        return sd_bus_reply_method_return(message, "b", 0);
+    int offset = 0;
+    char const* text = nullptr;
+    int length = 0;
+    if (sd_bus_message_read(message, "isi", &offset, &text, &length) < 0)
+        return -EINVAL;
+    (void)length;
+    auto current = node_text(node);
+    if (offset < 0)
+        offset = 0;
+    if (offset > static_cast<int>(current.length()))
+        offset = current.length();
+    auto updated = MUST(String::formatted("{}{}{}", current.substring_view(0, offset), text, current.substring_view(offset)));
+    node->source->set_text(move(updated));
+    return sd_bus_reply_method_return(message, "b", 1);
+}
+
+int DBusServer::handle_editable_delete_text(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto snapshot = static_cast<DBusServer*>(data)->flatten();
+    auto& nodes = snapshot.nodes;
+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    if (!node || !node->source || !node->source->editable || !node->source->set_text)
+        return sd_bus_reply_method_return(message, "b", 0);
+    int start = 0;
+    int end = 0;
+    if (sd_bus_message_read(message, "ii", &start, &end) < 0)
+        return -EINVAL;
+    auto current = node_text(node);
+    if (start < 0)
+        start = 0;
+    if (end < start)
+        end = start;
+    if (start > static_cast<int>(current.length()))
+        start = current.length();
+    if (end > static_cast<int>(current.length()))
+        end = current.length();
+    auto updated = MUST(String::formatted("{}{}", current.substring_view(0, start), current.substring_view(end)));
+    node->source->set_text(move(updated));
+    return sd_bus_reply_method_return(message, "b", 1);
+}
+
+int DBusServer::handle_editable_copy_text(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "b", 0);
+}
+
+int DBusServer::handle_editable_cut_text(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "b", 0);
+}
+
+int DBusServer::handle_editable_paste_text(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "b", 0);
+}
+
+int DBusServer::handle_introspect(sd_bus_message* message, void*, sd_bus_error*)
+{
+    return sd_bus_reply_method_return(message, "s", introspection_xml);
+}
+
+}
