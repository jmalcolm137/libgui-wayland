+int DBusServer::handle_component_contains(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto snapshot = static_cast<DBusServer*>(data)->flatten();
+    auto& nodes = snapshot.nodes;
+    auto* node = node_at(nodes, sd_bus_message_get_path(message));
+    int x = 0;
+    int y = 0;
+    unsigned coord_type = 0;
+    if (sd_bus_message_read(message, "iiu", &x, &y, &coord_type) < 0)
+        return -EINVAL;
+    (void)coord_type;
+    if (!node)
+        return reply_node_error(message);
+    return sd_bus_reply_method_return(message, "b", rect_contains(node->rect, x, y) ? 1 : 0);
+}
