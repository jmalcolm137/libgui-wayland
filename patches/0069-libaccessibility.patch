diff --git a/Userland/Libraries/LibAccessibility/Server.h b/Userland/Libraries/LibAccessibility/Server.h
new file mode 100644
index 00000000..3e8e62b8
--- /dev/null
+++ b/Userland/Libraries/LibAccessibility/Server.h
@@ -0,0 +1,104 @@
+/*
+ * Copyright (c) 2026, Serenity Desktop Environment contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Function.h>
+#include <AK/OwnPtr.h>
+#include <AK/String.h>
+#include <AK/Vector.h>
+#include <LibGfx/Rect.h>
+
+// A platform-neutral accessibility snapshot. The Linux backend publishes it on
+// the AT-SPI bus; LibGUI is the only producer and has no D-Bus types in its API.
+namespace Accessibility {
+
+// AtspiRole values from at-spi2-core's atspi-constants.h. Keep the numbers
+// stable: consumers compare them directly.
+enum class Role : int {
+    Invalid = 0,
+    CheckBox = 7,
+    ComboBox = 11,
+    Dialog = 16,
+    Frame = 23,
+    Label = 29,
+    List = 31,
+    Menu = 33,
+    MenuBar = 34,
+    MenuItem = 35,
+    PageTabList = 38,
+    Panel = 39,
+    ProgressBar = 42,
+    PushButton = 43,
+    RadioButton = 44,
+    ScrollBar = 48,
+    Slider = 51,
+    Table = 55,
+    Terminal = 60,
+    Text = 61,
+    ToggleButton = 62,
+    ToolBar = 63,
+    Tree = 65,
+    Window = 69,
+    Application = 75,
+    Entry = 79,
+    ListBox = 98,
+    Grouping = 99,
+    Static = 116,
+};
+
+// AtspiStateType: a bit index in the state set.
+enum State : u32 {
+    StateActive = 1u << 0,
+    StateChecked = 1u << 3,
+    StateEditable = 1u << 6,
+    StateEnabled = 1u << 8,
+    StateFocusable = 1u << 11,
+    StateFocused = 1u << 12,
+    StateSensitive = 1u << 23,
+    StateShowing = 1u << 25,
+    StateVisible = 1u << 30,
+};
+
+struct Node {
+    String name;
+    Role role { Role::Invalid };
+    Gfx::IntRect rect;
+    u32 states { 0 };
+    // AT-SPI actions are optional. The callback runs on the accessibility
+    // server's event-loop thread, which is the application's GUI thread.
+    String action_name;
+    Function<void()> action;
+    // Text/EditableText. `is_text` is separate from a non-empty string so an
+    // empty text editor still exposes the interface.
+    bool is_text { false };
+    bool editable { false };
+    String text;
+    Function<void(String)> set_text;
+    // Opaque producer tag (LibGUI stores a Widget*). The backend uses it to map
+    // an event from a live widget back to its current AT-SPI object path.
+    void* tag { nullptr };
+    Vector<Node> children;
+};
+
+// A live view of the application's widget tree. It is called on the D-Bus
+// thread/loop and must be cheap and non-blocking.
+using Snapshot = Function<Node()>;
+
+class Server {
+public:
+    virtual ~Server() = default;
+
+    // Returns nullptr when there is no accessibility bus (the normal case for a
+    // session without a screen reader) or when this platform has no backend.
+    static OwnPtr<Server> create(Snapshot);
+
+    // Optional event notifications. Backends without a transport ignore them.
+    virtual void notify_state_changed(void*, StringView, bool) { }
+    virtual void notify_text_changed(void*, StringView) { }
+};
+
+}
diff --git a/Userland/Libraries/LibGUI/AccessibilityServer.cpp b/Userland/Libraries/LibGUI/AccessibilityServer.cpp
new file mode 100644
index 00000000..1cb026f1
--- /dev/null
+++ b/Userland/Libraries/LibGUI/AccessibilityServer.cpp
@@ -0,0 +1,179 @@
+/*
+ * Copyright (c) 2026, Serenity Desktop Environment contributors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include "AccessibilityServer.h"
+
+#include <LibAccessibility/Server.h>
+#include <LibGUI/AbstractButton.h>
+#include <LibGUI/Application.h>
+#include <LibGUI/Button.h>
+#include <LibGUI/Label.h>
+#include <LibGUI/TextEditor.h>
+#include <LibGUI/Window.h>
+#include <LibGUI/Widget.h>
+
+namespace GUI {
+
+static OwnPtr<Accessibility::Server> s_server;
+
+static Accessibility::Role role_for(Widget const& widget)
+{
+    auto const& name = widget.class_name();
+    if (name == "GUI::Button")
+        return Accessibility::Role::PushButton;
+    if (name == "GUI::CheckBox")
+        return Accessibility::Role::CheckBox;
+    if (name == "GUI::RadioButton")
+        return Accessibility::Role::RadioButton;
+    if (name == "GUI::Label")
+        return Accessibility::Role::Label;
+    if (name == "GUI::TextEditor")
+        return Accessibility::Role::Text;
+    if (name == "GUI::TextBox" || name == "GUI::PasswordBox")
+        return Accessibility::Role::Entry;
+    if (name == "GUI::ComboBox")
+        return Accessibility::Role::ComboBox;
+    if (name == "GUI::Slider")
+        return Accessibility::Role::Slider;
+    if (name == "GUI::ScrollBar")
+        return Accessibility::Role::ScrollBar;
+    if (name == "GUI::ListView")
+        return Accessibility::Role::List;
+    if (name == "GUI::TreeView")
+        return Accessibility::Role::Tree;
+    if (name == "GUI::TableView")
+        return Accessibility::Role::Table;
+    if (name == "GUI::TabWidget")
+        return Accessibility::Role::PageTabList;
+    if (name == "GUI::GroupBox" || name == "GUI::Frame")
+        return Accessibility::Role::Panel;
+    if (name == "GUI::ProgressBar")
+        return Accessibility::Role::ProgressBar;
+    return Accessibility::Role::Panel;
+}
+
+static String name_for(Widget const& widget)
+{
+    if (widget.has_tooltip())
+        return widget.tooltip();
+    if (is<Label>(widget))
+        return static_cast<Label const&>(widget).text();
+    if (is<AbstractButton>(widget))
+        return static_cast<AbstractButton const&>(widget).text();
+    return {};
+}
+
+static Accessibility::Node snapshot_widget(Widget& widget)
+{
+    Accessibility::Node node;
+    node.role = role_for(widget);
+    node.name = name_for(widget);
+    node.rect = widget.screen_relative_rect();
+    node.tag = &widget;
+    if (widget.is_enabled()) {
+        node.states |= Accessibility::StateEnabled | Accessibility::StateSensitive;
+    }
+    if (widget.is_visible()) {
+        node.states |= Accessibility::StateVisible | Accessibility::StateShowing;
+    }
+    if (widget.is_auto_focusable())
+        node.states |= Accessibility::StateFocusable;
+    if (widget.is_focused())
+        node.states |= Accessibility::StateFocused;
+
+    if (is<Button>(widget)) {
+        auto& button = static_cast<Button&>(widget);
+        node.action_name = MUST(String::from_utf8("click"sv));
+        node.action = [&button] {
+            if (button.on_click)
+                button.on_click(0);
+        };
+    }
+
+    if (is<Label>(widget)) {
+        node.is_text = true;
+        node.text = static_cast<Label const&>(widget).text();
+    } else if (is<AbstractButton>(widget)) {
+        node.is_text = true;
+        node.text = static_cast<AbstractButton const&>(widget).text();
+    } else if (is<TextEditor>(widget)) {
+        auto& editor = static_cast<TextEditor&>(widget);
+        node.is_text = true;
+        node.editable = editor.is_editable();
+        node.text = MUST(String::from_byte_string(editor.text()));
+        node.set_text = [&editor](String text) {
+            editor.set_text(text);
+        };
+    }
+
+    for (auto& child : widget.child_widgets()) {
+        if (child.is_visible())
+            node.children.append(snapshot_widget(child));
+    }
+    return node;
+}
+
+static Accessibility::Node snapshot()
+{
+    Accessibility::Node root;
+    root.role = Accessibility::Role::Application;
+    if (auto* app = Application::the())
+        root.name = MUST(String::from_byte_string(app->invoked_as()));
+
+    for (auto* window_ptr : Window::windows_for_accessibility()) {
+        auto& window = *window_ptr;
+        if (!window.is_visible())
+            continue;
+        Accessibility::Node frame;
+        frame.role = Accessibility::Role::Frame;
+        frame.name = MUST(String::from_byte_string(window.title()));
+        frame.rect = window.rect();
+        frame.tag = &window;
+        if (window.is_active())
+            frame.states |= Accessibility::StateFocused | Accessibility::StateActive;
+        if (window.main_widget()) {
+            auto& main = *window.main_widget();
+            frame.children.append(snapshot_widget(main));
+            // The window is the AT-SPI frame; expose the main widget's children
+            // directly rather than an uninteresting root panel. Move them out
+            // first: assigning frame.children from one of its own elements would
+            // destroy the source while the vector is being replaced.
+            auto main_children = move(frame.children[0].children);
+            frame.children = move(main_children);
+        }
+        root.children.append(move(frame));
+    }
+
+    return root;
+}
+
+void AccessibilityServer::initialize()
+{
+    if (s_server)
+        return;
+    s_server = Accessibility::Server::create(snapshot);
+}
+
+void AccessibilityServer::shutdown()
+{
+    s_server = nullptr;
+}
+
+void AccessibilityServer::notify_state_changed(Widget& widget, StringView state, bool enabled)
+{
+    if (s_server)
+        s_server->notify_state_changed(&widget, state, enabled);
+}
+
+void AccessibilityServer::notify_text_changed(TextEditor& editor)
+{
+    if (!s_server)
+        return;
+    auto text = editor.text();
+    s_server->notify_text_changed(&editor, StringView { text.characters(), text.length() });
+}
+
+}
