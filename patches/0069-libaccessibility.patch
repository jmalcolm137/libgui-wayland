+int DBusServer::handle_component_get_accessible_at_point(sd_bus_message* message, void* data, sd_bus_error*)
+{
+    auto& server = *static_cast<DBusServer*>(data);
+    auto snapshot = server.flatten();
+    auto& nodes = snapshot.nodes;
+    int x = 0;
+    int y = 0;
+    unsigned coord_type = 0;
+    if (sd_bus_message_read(message, "iiu", &x, &y, &coord_type) < 0)
+        return -EINVAL;
+    (void)coord_type;
+
+    int best = -1;
+    int best_area = 0;
+    for (int i = 0; i < static_cast<int>(nodes.size()); ++i) {
+        auto const& rect = nodes[i].rect;
+        if (!rect_contains(rect, x, y))
+            continue;
+        int const area = rect.width() * rect.height();
+        if (best < 0 || area < best_area) {
+            best = i;
+            best_area = area;
+        }
+    }
+    if (best < 0)
+        return sd_bus_reply_method_return(message, "(so)", "", "/");
+    return sd_bus_reply_method_return(message, "(so)", server.m_bus_name.characters(), nodes[best].path.characters());
+}
