+DBusServer::DBusServer(Snapshot snapshot)
+    : m_snapshot(move(snapshot))
+{
+    // Only start on the dedicated accessibility bus. The session bus normally
+    // has no AT-SPI registry; registering an application name there makes every
+    // app a bogus accessibility service.
+    char const* address = getenv("AT_SPI_BUS_ADDRESS");
+    if (!address || !*address)
+        return;
+
+    if (sd_bus_new(&m_bus) < 0) {
+        dbgln("Accessibility: sd_bus_new failed");
+        return;
+    }
+    if (sd_bus_set_address(m_bus, address) < 0) {
+        dbgln("Accessibility: sd_bus_set_address failed: {} ({})", address, strerror(errno));
+        sd_bus_unref(m_bus);
+        m_bus = nullptr;
+        return;
+    }
+    if (sd_bus_set_bus_client(m_bus, 1) < 0 || sd_bus_start(m_bus) < 0) {
+        dbgln("Accessibility: sd_bus_start failed: {}", strerror(errno));
+        sd_bus_unref(m_bus);
+        m_bus = nullptr;
+        return;
+    }
+
+    m_bus_name = ByteString::formatted("org.a11y.atspi.App_{}", getpid());
+    int request_result = sd_bus_request_name(m_bus, m_bus_name.characters(), 0);
+    if (request_result < 0) {
+        dbgln("Accessibility: request_name failed: {} ({})", request_result, strerror(-request_result));
+        sd_bus_unref(m_bus);
+        m_bus = nullptr;
+        return;
+    }
+
+    static sd_bus_vtable const vtable[] = {
+        SD_BUS_VTABLE_START(0),
+        SD_BUS_METHOD("GetRole", "", "i", handle_get_role, 0),
+        SD_BUS_METHOD("GetName", "", "s", handle_get_name, 0),
+        SD_BUS_METHOD("GetDescription", "", "s", handle_get_description, 0),
+        SD_BUS_METHOD("GetChildCount", "", "i", handle_get_child_count, 0),
+        SD_BUS_METHOD("GetChildren", "", "a(so)", handle_get_children, 0),
+        SD_BUS_METHOD("GetState", "", "au", handle_get_state, 0),
+        SD_BUS_METHOD("GetParent", "", "(so)", handle_get_parent, 0),
+        SD_BUS_METHOD("GetApplication", "", "(so)", handle_get_application, 0),
+        SD_BUS_METHOD("GetInterfaces", "", "as", handle_get_interfaces, 0),
+        SD_BUS_METHOD("Introspect", "", "s", handle_introspect, 0),
+        SD_BUS_VTABLE_END,
+    };
+    static sd_bus_vtable const component_vtable[] = {
+        SD_BUS_VTABLE_START(0),
+        SD_BUS_METHOD("Contains", "iiu", "b", handle_component_contains, 0),
+        SD_BUS_METHOD("GetAccessibleAtPoint", "iiu", "(so)", handle_component_get_accessible_at_point, 0),
+        SD_BUS_METHOD("GetExtents", "u", "(iiii)", handle_component_get_extents, 0),
+        SD_BUS_METHOD("GetPosition", "u", "(ii)", handle_component_get_position, 0),
+        SD_BUS_METHOD("GetSize", "", "(ii)", handle_component_get_size, 0),
+        SD_BUS_METHOD("GetLayer", "", "u", handle_component_get_layer, 0),
+        SD_BUS_METHOD("GetMDIZOrder", "", "i", handle_component_get_mdi_z_order, 0),
+        SD_BUS_METHOD("GrabFocus", "", "b", handle_component_grab_focus, 0),
+        SD_BUS_VTABLE_END,
+    };
+    (void)sd_bus_add_object_vtable(m_bus, nullptr, root_path, "org.a11y.atspi.Accessible", vtable, this);
+    (void)sd_bus_add_fallback_vtable(m_bus, nullptr, accessible_prefix, "org.a11y.atspi.Accessible", vtable, nullptr, this);
+    static sd_bus_vtable const action_vtable[] = {
+        SD_BUS_VTABLE_START(0),
+        SD_BUS_METHOD("GetActions", "", "a(sss)", handle_action_get_actions, 0),
+        SD_BUS_METHOD("DoAction", "i", "b", handle_action_do_action, 0),
+        SD_BUS_METHOD("GetActionName", "i", "s", handle_action_get_action_name, 0),
+        SD_BUS_METHOD("GetActionDescription", "i", "s", handle_action_get_action_description, 0),
+        SD_BUS_METHOD("GetKeyBinding", "i", "s", handle_action_get_key_binding, 0),
+        SD_BUS_VTABLE_END,
+    };
+    (void)sd_bus_add_object_vtable(m_bus, nullptr, root_path, "org.a11y.atspi.Component", component_vtable, this);
+    (void)sd_bus_add_fallback_vtable(m_bus, nullptr, accessible_prefix, "org.a11y.atspi.Component", component_vtable, nullptr, this);
+    (void)sd_bus_add_object_vtable(m_bus, nullptr, root_path, "org.a11y.atspi.Action", action_vtable, this);
+    (void)sd_bus_add_fallback_vtable(m_bus, nullptr, accessible_prefix, "org.a11y.atspi.Action", action_vtable, nullptr, this);
+
+    static sd_bus_vtable const text_vtable[] = {
+        SD_BUS_VTABLE_START(0),
+        SD_BUS_METHOD("GetText", "ii", "s", handle_text_get_text, 0),
+        SD_BUS_METHOD("GetStringAtOffset", "iu", "(sii)", handle_text_get_string_at_offset, 0),
+        SD_BUS_METHOD("GetCharacterCount", "", "i", handle_text_get_character_count, 0),
+        SD_BUS_METHOD("GetCharacterAtOffset", "i", "i", handle_text_get_character_at_offset, 0),
+        SD_BUS_METHOD("GetTextAtOffset", "iu", "(sii)", handle_text_get_text_at_offset, 0),
+        SD_BUS_METHOD("GetAttributeValue", "is", "s", handle_text_get_attribute_value, 0),
+        SD_BUS_METHOD("GetAttributes", "i", "(a{ss}ii)", handle_text_get_attributes, 0),
+        SD_BUS_METHOD("GetDefaultAttributes", "", "a{ss}", handle_text_get_default_attributes, 0),
+        SD_BUS_METHOD("GetCharacterExtents", "iu", "(iiii)", handle_text_get_character_extents, 0),
+        SD_BUS_METHOD("GetRangeExtents", "iiu", "(iiii)", handle_text_get_range_extents, 0),
+        SD_BUS_METHOD("GetOffsetAtPoint", "iiu", "i", handle_text_get_offset_at_point, 0),
+        SD_BUS_METHOD("GetNSelections", "", "i", handle_text_get_n_selections, 0),
+        SD_BUS_METHOD("GetSelection", "i", "(ii)", handle_text_get_selection, 0),
+        SD_BUS_METHOD("AddSelection", "ii", "b", handle_text_add_selection, 0),
+        SD_BUS_METHOD("RemoveSelection", "i", "b", handle_text_remove_selection, 0),
+        SD_BUS_METHOD("SetSelection", "iii", "b", handle_text_set_selection, 0),
+        SD_BUS_METHOD("SetCaretOffset", "i", "b", handle_text_set_caret_offset, 0),
+        SD_BUS_METHOD("ScrollSubstringTo", "iiu", "b", handle_text_scroll_substring_to, 0),
+        SD_BUS_METHOD("ScrollSubstringToPoint", "iiuii", "b", handle_text_scroll_substring_to_point, 0),
+        SD_BUS_VTABLE_END,
+    };
+    (void)sd_bus_add_object_vtable(m_bus, nullptr, root_path, "org.a11y.atspi.Text", text_vtable, this);
+    (void)sd_bus_add_fallback_vtable(m_bus, nullptr, accessible_prefix, "org.a11y.atspi.Text", text_vtable, nullptr, this);
+
+    static sd_bus_vtable const editable_vtable[] = {
+        SD_BUS_VTABLE_START(0),
+        SD_BUS_METHOD("SetTextContents", "s", "b", handle_editable_set_text_contents, 0),
+        SD_BUS_METHOD("InsertText", "isi", "b", handle_editable_insert_text, 0),
+        SD_BUS_METHOD("DeleteText", "ii", "b", handle_editable_delete_text, 0),
+        SD_BUS_METHOD("CopyText", "ii", "b", handle_editable_copy_text, 0),
+        SD_BUS_METHOD("CutText", "ii", "b", handle_editable_cut_text, 0),
+        SD_BUS_METHOD("PasteText", "i", "b", handle_editable_paste_text, 0),
+        SD_BUS_VTABLE_END,
+    };
+    (void)sd_bus_add_object_vtable(m_bus, nullptr, root_path, "org.a11y.atspi.EditableText", editable_vtable, this);
+    (void)sd_bus_add_fallback_vtable(m_bus, nullptr, accessible_prefix, "org.a11y.atspi.EditableText", editable_vtable, nullptr, this);
+
+    dbgln("Accessibility: serving as {}", m_bus_name);
+    m_notifier = Core::Notifier::construct(sd_bus_get_fd(m_bus), Core::Notifier::Type::Read);
+    m_notifier->on_activation = [this] {
+        while (m_bus && sd_bus_process(m_bus, nullptr) > 0) { }
+        if (m_bus)
+            (void)sd_bus_flush(m_bus);
+    };
+}
+
+DBusServer::~DBusServer()
+{
+    if (m_notifier)
+        m_notifier->set_enabled(false);
+    if (m_bus)
+        sd_bus_flush_close_unref(m_bus);
+}
+
+int DBusServer::index_for_path(char const* path)
+{
+    if (!path)
+        return -1;
+    if (!strcmp(path, root_path))
+        return 0;
+    auto const prefix_length = strlen(accessible_prefix);
+    if (strncmp(path, accessible_prefix, prefix_length) != 0)
+        return -1;
+    auto suffix = StringView { path + prefix_length, strlen(path + prefix_length) };
+    if (suffix.starts_with('/'))
+        suffix = suffix.substring_view(1);
+    return suffix.to_number<int>().value_or(-1);
+}
+
+DBusServer::FlattenedSnapshot DBusServer::flatten()
+{
+    Node root = m_snapshot();
+    Vector<FlatNode> nodes;
+
+    Function<void(Node const&, int)> add = [&](Node const& node, int parent) {
+        int const index = nodes.size();
+        FlatNode flat;
+        flat.path = index == 0 ? ByteString { root_path } : ByteString::formatted("{}/{}", accessible_prefix, index);
+        flat.name = node.name;
+        flat.role = node.role;
+        flat.rect = node.rect;
+        flat.states = node.states;
+        flat.parent = parent;
+        flat.source = &node;
+        nodes.append(move(flat));
+        if (parent >= 0)
+            nodes[parent].children.append(index);
+        for (auto const& child : node.children)
+            add(child, index);
+    };
+
+    add(root, -1);
+    return { move(root), move(nodes) };
+}
+
+ByteString DBusServer::path_for_tag(void* tag)
+{
+    if (!tag)
+        return {};
+    auto snapshot = flatten();
+    for (auto const& node : snapshot.nodes) {
+        if (node.source && node.source->tag == tag)
+            return node.path;
+    }
+    return {};
+}
+
+void DBusServer::notify_state_changed(void* tag, StringView state, bool enabled)
+{
+    if (!m_bus)
+        return;
+    auto path = path_for_tag(tag);
+    if (path.is_empty())
+        return;
+    auto state_string = MUST(String::from_utf8(state));
+    auto state_bytes = state_string.to_byte_string();
+
+    sd_bus_message* message = nullptr;
+    if (sd_bus_message_new_signal(m_bus, &message, path.characters(), "org.a11y.atspi.Event.Object", "StateChanged") < 0)
+        return;
+    int result = sd_bus_message_append(message, "s", state_bytes.characters());
+    if (result >= 0)
+        result = sd_bus_message_append(message, "i", enabled ? 1 : 0);
+    if (result >= 0)
+        result = sd_bus_message_append(message, "i", 0);
+    if (result >= 0)
+        result = sd_bus_message_append(message, "v", "s", "");
+    if (result >= 0)
+        result = sd_bus_message_open_container(message, 'a', "{sv}");
+    if (result >= 0)
+        result = sd_bus_message_close_container(message);
+    if (result >= 0)
+        (void)sd_bus_send(nullptr, message, nullptr);
+    sd_bus_message_unref(message);
+}
+
+void DBusServer::notify_text_changed(void* tag, StringView text)
+{
+    if (!m_bus)
+        return;
+    auto path = path_for_tag(tag);
+    if (path.is_empty())
+        return;
+    auto text_string = MUST(String::from_utf8(text));
+    auto text_bytes = text_string.to_byte_string();
+
+    sd_bus_message* message = nullptr;
+    if (sd_bus_message_new_signal(m_bus, &message, path.characters(), "org.a11y.atspi.Event.Object", "TextChanged") < 0)
+        return;
+    int result = sd_bus_message_append(message, "s", "update");
+    if (result >= 0)
+        result = sd_bus_message_append(message, "i", 0);
+    if (result >= 0)
+        result = sd_bus_message_append(message, "i", static_cast<int>(text.length()));
+    if (result >= 0)
+        result = sd_bus_message_append(message, "v", "s", text_bytes.characters());
+    if (result >= 0)
+        result = sd_bus_message_open_container(message, 'a', "{sv}");
+    if (result >= 0)
+        result = sd_bus_message_close_container(message);
+    if (result >= 0)
+        (void)sd_bus_send(nullptr, message, nullptr);
+    sd_bus_message_unref(message);
+}
