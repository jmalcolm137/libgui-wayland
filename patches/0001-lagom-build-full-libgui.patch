diff --git a/Meta/CMake/serenity_components.cmake b/Meta/CMake/serenity_components.cmake
index af660542..7a88a65b 100644
--- a/Meta/CMake/serenity_components.cmake
+++ b/Meta/CMake/serenity_components.cmake
@@ -30,13 +30,22 @@ function(serenity_component name)
     set(should_disable_target $<BOOL:${static_should_disable_target}>)
     if(NOT "${SERENITY_COMPONENT_TARGETS}" STREQUAL "") # note: one component is /bin/false, which makes this tricky
         foreach(target IN LISTS SERENITY_COMPONENT_TARGETS)
+            # libgui-wayland: a component may also name helper executables that
+            # are not built under Lagom (utmpupdate, Profiler, ...).
+            if (NOT TARGET "${target}")
+                continue()
+            endif()
             add_dependencies("Component${name}" "${target}")
             set(should_disable_target $<OR:${should_disable_target},$<BOOL:$<TARGET_PROPERTY:${target},SERENITY_SKIP_BUILD>>>)
         endforeach()
     endif()
     set_target_properties("Component${name}" PROPERTIES EXCLUDE_FROM_ALL ${should_disable_target})
     foreach(dependency IN LISTS SERENITY_COMPONENT_DEPENDS)
-        add_dependencies("Component${name}" "Component${dependency}")
+        # libgui-wayland: services gated on SERENITYOS have no component target
+        # in a Lagom build, so only add dependencies that exist.
+        if (TARGET "Component${dependency}")
+            add_dependencies("Component${name}" "Component${dependency}")
+        endif()
     endforeach()
 endfunction()
 
