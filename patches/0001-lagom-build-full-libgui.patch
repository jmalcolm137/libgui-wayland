+        # stringify_gml and embedded resources). Applications that need the
+        # (disabled) LibWeb/LibWebView stack are omitted.
+        # ------------------------------------------------------------------
+        set(libgui_wayland_apps
+            About
+            AnalogClock
+            Assistant
+            Calendar
+            CalendarSettings
+            CharacterMap
+            ClockSettings
+            Escalator
+            FileManager
+            FontEditor
