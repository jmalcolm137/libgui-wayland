+        compile_ipc(${SERENITY_PROJECT_ROOT}/Userland/Services/AudioServer/AudioManagerClient.ipc Userland/Services/AudioServer/AudioManagerClientEndpoint.h)
+        compile_ipc(${SERENITY_PROJECT_ROOT}/Userland/Services/AudioServer/AudioManagerServer.ipc Userland/Services/AudioServer/AudioManagerServerEndpoint.h)
