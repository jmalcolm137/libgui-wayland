 function(embed_resource target section file)
+    if (NOT SERENITYOS)
+        # libgui-wayland: the host loads resources from the filesystem
+        # (`/res` -> SERENITY_RES_ROOT), so skip the assembly-embedded copy
+        # (which needs ASM enabled and the Serenity linker script).
+        add_library(${target}-resources-${section} INTERFACE)
